---
/*
 * Deliverable 02, version B (trial, entry 254): exported to public/annons/velora-annons-9x16-b.png.
 * Same layout as version A (src/components/Ad.astro). Headline is the start page's hero title; the
 * subtitle carries the biology point from the hero lede (entries 137, 194), then the care team
 * (entry 258, replacing "Kroppen försvarar sin vikt"). Entry 259: line breaks set by hand, so the
 * third line is only "följer dig hela vägen." Photo: velora.se's own hero (entries 261, 263; set in Ad.astro).
 */
import Ad from '../components/Ad.astro';
---

<!doctype html>
<html lang="sv">
	<head>
		<meta charset="utf-8" />
		<!-- The ad is a fixed 1080 px canvas; phones scale it down to fit. -->
		<meta name="viewport" content="width=1080" />
		<meta name="robots" content="noindex, nofollow" />
		<title>Velora – annons 9:16, version B</title>
	</head>
	<body>
		<Ad
			title="Medicinsk viktnedgång"
			emphasis="när dieter inte räcker"
			lede={['Det handlar om biologi, inte bara om vilja.', 'Hos Velora får du ett vårdteam som', 'följer dig hela vägen.']}
		/>
	</body>
</html>
