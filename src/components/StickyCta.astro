---
import { CTA } from '../data/site';
---

<!--
  Calm sticky action bar, mobile only. Appears once the hero CTA has scrolled away,
  and steps aside whenever another CTA is already on screen so the action never doubles up.
-->
<div class="sticky" data-sticky hidden>
	<a class="btn" href={CTA.href}>{CTA.label}</a>
	<p>{CTA.shortNote}</p>
</div>

<script>
	const bar = document.querySelector<HTMLElement>('[data-sticky]');
	const hero = document.querySelector<HTMLElement>('[data-hero-cta]');
	const inline = document.querySelectorAll<HTMLElement>('[data-cta-inline]');

	if (bar && hero) {
		bar.hidden = false;
		let pastHero = false;
		const visible = new Set<Element>();

		const render = () => {
			const show = pastHero && visible.size === 0;
			bar.classList.toggle('is-visible', show);
			bar.inert = !show;
		};

		new IntersectionObserver(([entry]) => {
			// Only count as "past" when the hero CTA has left through the top of the viewport.
			pastHero = !entry.isIntersecting && entry.boundingClientRect.top < 0;
			render();
		}).observe(hero);

		const io = new IntersectionObserver((entries) => {
			for (const e of entries) {
				if (e.target.closest('[data-hero-cta]')) continue;
				e.isIntersecting ? visible.add(e.target) : visible.delete(e.target);
			}
			render();
		});
		inline.forEach((el) => io.observe(el));
		render();
	}
</script>

<style>
	.sticky {
		position: fixed;
		inset: auto 0 0;
		z-index: 50;
		padding: 12px var(--gutter) calc(12px + env(safe-area-inset-bottom));
		background: rgba(247, 242, 236, 0.92);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border-top: 1px solid var(--line);
		display: grid;
		gap: 6px;
		text-align: center;
		transform: translateY(100%);
		opacity: 0;
		transition:
			transform 320ms var(--ease),
			opacity 320ms var(--ease);
	}

	.sticky.is-visible {
		transform: none;
		opacity: 1;
	}

	.btn {
		display: flex;
		align-items: center;
		justify-content: center;
		min-height: 50px;
		border-radius: 999px;
		background: var(--wine);
		color: var(--cream);
		font-weight: 600;
		text-decoration: none;
	}

	p {
		font-size: 0.8125rem;
		color: var(--ink-soft);
	}

	@media (prefers-reduced-motion: reduce) {
		.sticky {
			transform: none;
			transition: opacity 120ms linear;
		}
	}

	@media (min-width: 768px) {
		.sticky {
			display: none;
		}
	}
</style>
