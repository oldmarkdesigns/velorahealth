---
import '@fontsource-variable/cormorant-garamond/wght.css';
import '@fontsource-variable/cormorant-garamond/wght-italic.css';
import CtaButton from './CtaButton.astro';
import HeroTrustPill from './HeroTrustPill.astro';
---

<!--
  Full-viewport cover (Relivo / Oura / Tandem pattern). The photo is light, so a cream
  gradient carries wine text instead of a dark scrim; it also softens the 1024 px source
  when it is scaled up. Swap IMG.hero for an extended/high-res version when available.
-->
<section class="hero" aria-labelledby="hero-title">
	<!--
	  Hero image (prompt log entries 99–100): AI-generated by Samuel from a reference cabin photo,
	  prompt in docs/prompt-log.md entry 99. Previous trials: hero-sunset.webp (entry 79); the
	  original velora.se photo was IMG.hero with IMG.heroSmall/heroMedium in srcset.
	-->
	<img
		class="photo"
		data-load="photo"
		src="/images/hero-lake.webp"
		srcset="/images/hero-lake.webp 1679w, /images/hero-lake-2x.webp 3358w"
		sizes="100vw"
		alt="Kvinna i en fåtölj vid ett stort fönster mot en skogssjö, i ett videosamtal på mobilen"
		width="1679"
		height="937"
		fetchpriority="high"
	/>
	<!-- Desktop: a dark wash that deepens from right to left behind the text (entry 102). -->
	<div class="shade" aria-hidden="true"></div>
	<div class="veil" aria-hidden="true"></div>
	<div class="container content">
		<!-- Desktop: the content sits on a frosted, see-through card (entry 107); a plain wrapper below. -->
		<div class="hero-card">
		<!-- Entry 141: the hero text arrives top to bottom after the photo (load sequence in global.css). -->
		<div data-load style="--load-delay: 250ms"><HeroTrustPill /></div>
		<h1 id="hero-title">
			<span class="line-1" data-load style="--load-delay: 380ms">Medicinsk viktnedgång</span>
			<span class="line-2" data-load style="--load-delay: 480ms">när dieter inte räcker</span>
		</h1>
		<p class="lede" data-load style="--load-delay: 600ms">
			Velora är en svensk digital vårdgivare. Ett legitimerat vårdteam bedömer om medicinsk behandling passar dig,
			och följer dig hela vägen.
		</p>
		<div class="cta-wrap" data-hero-cta data-load style="--load-delay: 720ms"><CtaButton label="Se om behandlingen passar dig" /></div>
		</div>
	</div>
</section>

<style>
	/*
	 * Inset, rounded panel (Hemmapartner-inspired): the photo sits like a framed image on the page,
	 * with the static trust bar directly beneath it.
	 */
	.hero {
		position: relative;
		min-height: calc(100svh - 16px);
		margin: 8px;
		border-radius: 16px;
		display: flex;
		align-items: flex-end;
		overflow: hidden;
		background: var(--stone);
	}

	/*
	 * Mobile: a full-height cover zooms into her face and the headline lands on it.
	 * So the photo bleeds edge to edge across the top and dissolves into cream; the text sits below.
	 */
	.photo {
		position: absolute;
		inset: 0 0 auto;
		width: 100%;
		height: 56%;
		object-fit: cover;
		/* Phones: the woman and chair sit on the right of the frame. */
		object-position: 82% 50%;
	}

	/* The dark wash is desktop-only (see the 1024 px block). */
	.shade {
		display: none;
	}

	.veil {
		position: absolute;
		inset: 0;
		/* Photo dissolves into cream below; no light wash at the top (removed in entry 104). */
		background: linear-gradient(to bottom, rgba(247, 242, 236, 0) 34%, var(--cream) 56%);
	}

	.content {
		position: relative;
		padding-top: 120px;
		padding-bottom: 32px;
		/* Lets the title size itself against the text column (cqi), not the window. */
		container-type: inline-size;
	}

	/*
	 * Hero title has its own serif (Cormorant Garamond), distinct from the Newsreader used for every
	 * other heading. Two fixed lines: upright statement, then the italic, softer qualifier.
	 */
	h1 {
		font-family: 'Cormorant Garamond Variable', var(--serif);
		/*
		 * The widest line ("Medicinsk viktnedgång") measures ~8.9em in this face, so 100cqi / 9.2 is the
		 * largest size that keeps each line on one line in any column width, with a small safety margin.
		 */
		font-size: clamp(1.5rem, 100cqi / 9.2, 4.5rem);
		line-height: 1.05;
		letter-spacing: -0.01em;
	}

	h1 span {
		display: block;
	}

	.line-1 {
		font-weight: 600;
		color: var(--ink);
	}

	/* Italic of the same family, lighter and softer: a change of voice, not a second typeface. */
	.line-2 {
		font-style: italic;
		font-weight: 500;
		color: var(--ink-soft);
	}

	.lede {
		margin-top: 16px;
		font-size: 1.0625rem;
		color: var(--ink);
		opacity: 0.82;
	}

	.cta-wrap {
		margin-top: 24px;
	}

	/*
	 * Tablets keep the phone layout (photo on top, text below on cream): the landscape lake photo
	 * can't be cropped on a tall tablet screen without putting her behind the headline (entry 100).
	 */
	@media (min-width: 768px) {
		.content {
			padding-bottom: 72px;
		}

		.lede {
			font-size: 1.1875rem;
		}
	}

	/*
	 * Entries 107, 110–111: on desktop the pill, headline, intro and button share one card on the
	 * left: a plain, see-through dark grey (no blur, border or glass sheen). On it the text is light
	 * cream; no text glow is needed.
	 */
	@media (min-width: 1024px) {
		.hero-card {
			width: fit-content;
			max-width: 760px;
			padding: 36px 40px 40px;
			border-radius: 20px;
			/* Entry 112: no fill of its own; the page-wide overlay gives the text its contrast. */
			background: none;
		}

		.hero-card .line-1,
		.hero-card .lede {
			color: var(--cream);
			text-shadow: none;
		}

		.hero-card .line-2 {
			color: rgba(247, 242, 236, 0.86);
			text-shadow: none;
		}

		/* Entries 118, 123: on the darkened photo the button is white with wine text; wine below 1024 px. */
		.cta-wrap :global(.btn) {
			background: #fff;
			color: var(--wine);
		}

		.cta-wrap :global(.btn:hover) {
			background: var(--cream);
		}
	}


	/*
	 * Small laptops (entry 103): the photo is cropped tighter, so the headline steps down to 60 px to
	 * stay clear of her. Everything else in the hero is unchanged.
	 */
	@media (min-width: 1024px) and (max-width: 1279px) {
		h1 {
			font-size: 3.75rem;
		}

		/* Entry 107: a narrower card here, so it doesn't cover her; the pill scales to fit inside it. */
		/* The compact pill needs ~583 px; 660 − 2 × 32 leaves 596. */
		.hero-card {
			max-width: 660px;
			padding-inline: 32px;
		}

		/* A compact pill (smaller type, avatars, icons and dividers) so it fits the narrower card. */
		.hero-card :global(.pill) {
			padding: 8px 18px 8px 8px;
		}

		.hero-card :global(.pill li) {
			font-size: 0.9375rem;
		}

		.hero-card :global(.pill li + li::before) {
			margin-inline: 10px;
		}

		.hero-card :global(.pill .avatars img),
		.hero-card :global(.pill .icon) {
			width: 28px;
			height: 28px;
		}

		.hero-card :global(.pill .icon svg) {
			width: 16px;
			height: 16px;
		}
	}

	/*
	 * Desktop: the photo fills the whole panel unfaded (entries 82, 100); the lake photo leaves its
	 * left half open for the text, and she sits on the right.
	 */
	@media (min-width: 1024px) {
		/* Fills the first screen together with the bar: flexes inside .first-screen (index.astro). */
		.hero {
			align-items: center;
			flex: 1 0 auto;
			min-height: 0;
			border-radius: 20px;
		}

		/*
		 * Entry 102 (replaces entry 101's blur): a black wash (wine-black until entry 105), clear on the right where she sits
		 * and deepening towards the left edge behind the text. Eased with extra stops so it reads as
		 * light falling off rather than a hard band. Desktop only: on phones and tablets the text
		 * sits below the photo.
		 */
		/*
		 * Entry 112: the overlay now runs top to bottom (it ran right to left in entries 102–105):
		 * clear at the top, where the navbar sits on the photo, deepening to the bottom edge. Eased
		 * stops so it reads as falling light rather than a band.
		 */
		.shade {
			display: block;
			position: absolute;
			inset: 0;
			pointer-events: none;
			background: linear-gradient(
				to bottom,
				rgba(0, 0, 0, 0) 0%,
				rgba(0, 0, 0, 0.1) 25%,
				rgba(0, 0, 0, 0.28) 50%,
				rgba(0, 0, 0, 0.45) 75%,
				rgba(0, 0, 0, 0.58) 100%
			);
		}

		/* Entry 82: the photo fills the whole panel, with no cream fade on the left. */
		.photo {
			inset: 0;
			width: 100%;
			height: 100%;
			/* Entry 103: as far right as the frame allows, so she stays clear of the headline at 1024 px. */
			object-position: 100% 50%;
		}

		/* Entry 104: no top wash either; the navbar sits straight on the photo. */
		.veil {
			display: none;
		}

		/*
		 * Entry 106: with no overlay the photo is light (pale sky and water), so the text is wine with
		 * a soft wide cream glow that lifts it off the dark treeline (as in entry 100). With the dark
		 * overlay (entry 102), it was cream instead.
		 */
		.line-1,
		.line-2,
		.lede {
			text-shadow:
				0 0 2px rgba(247, 242, 236, 0.7),
				0 0 14px rgba(247, 242, 236, 0.8),
				0 0 36px rgba(247, 242, 236, 0.75);
		}

		/* The italic line crosses the darkest reflections, so it's a little deeper than ink-soft here. */
		.line-2 {
			color: #4a2a38;
		}

		.lede {
			opacity: 1;
		}

		.content {
			padding-top: 80px;
			padding-bottom: 0;
		}


	}
</style>
