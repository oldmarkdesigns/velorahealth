---
import checkIcon from '@phosphor-icons/core/assets/light/check-light.svg?raw';
import { VELORA } from '../data/site';
import CtaButton from './CtaButton.astro';
import SwitchBlock from './SwitchBlock.astro';

// Layout from entry 88: Velorametoden and Underhåll side by side, then the extra costs as a ruled
// table beneath them (after the "Våra planer i detalj" reference). Same content as layout F.
// All figures as on velora.se (docs/facts.md).
const method = [
	'Din egen läkare, expert på medicinsk viktnedgång',
	'Personlig coach och dietist',
	'Tillgång dygnet runt till vår webbapp för stöd och rådgivning',
];
const maintenance = [
	'Hjälp med att behålla din målvikt',
	'Optimerad läkemedelsdosering för lägre kostnad',
	'Fortsatt support från hela Veloras expertteam',
	'Flexibelt upplägg utan bindningstid',
];
---

<section class="section stone" id="pris" aria-labelledby="price-title">
	<div class="container">
		<div data-reveal>
			<p class="label">Pris</p>
			<h2 id="price-title">Hela kostnaden. <em>Inga dolda avgifter.</em></h2>
		</div>

		<div class="plans">
			<!-- Featured plan -->
			<div class="featured" data-reveal>
				<p class="plan-name">Velorametoden</p>
				<p class="price"><span class="unit">från</span> 795<span class="unit"> kr/mån</span></p>
				<ul class="checks" role="list">
					{
						method.map((item) => (
							<li>
								<span class="check" aria-hidden="true" set:html={checkIcon} />
								{item}
							</li>
						))
					}
				</ul>
				<div class="featured-foot">
					<p class="small">Du kan välja upplägg utan bindningstid. Studerar du på heltid: 695 kr/mån.</p>
					<CtaButton tone="cream" label="Kom igång" />
				</div>
			</div>

			<!-- Velora Underhåll, its own card. -->
			<div class="maintenance" data-reveal>
				<p class="plan-name">Velora Underhåll</p>
				<p class="price">495<span class="unit"> kr/mån</span></p>
				<p class="intro">När du uppnått din målvikt och vill bygga vidare på dina framgångar.</p>
				<ul class="checks" role="list">
					{
						maintenance.map((item) => (
							<li>
								<span class="check" aria-hidden="true" set:html={checkIcon} />
								{item}
							</li>
						))
					}
				</ul>
				<p class="small foot">Kostnaden för läkemedel ingår inte i priset.</p>
			</div>
		</div>

		<!-- What comes on top of the monthly fee: a ruled table, one row per cost. -->
		<div class="costs" data-reveal>
			<div class="costs-head">
				<p class="costs-title">Det här tillkommer</p>
				<p class="aside">utöver månadsavgiften</p>
			</div>
			<dl>
				<div class="row">
					<dt>Hälsokontroll <span class="when">en gång</span></dt>
					<dd class="desc">Blodprover och läkargenomgång. Har du nyligen tagit proverna betalar du bara för genomgången, 495 kr.</dd>
					<dd class="amount">995 <span class="unit">kr</span></dd>
				</div>
				<div class="row">
					<dt>Läkemedel <span class="when">apotek</span></dt>
					<dd class="desc">Beror på läkemedel och dos (oktober 2026).</dd>
					<dd class="amount"><span class="unit">ca</span> 1 050–4 800 <span class="unit">kr/mån</span></dd>
				</div>
			</dl>
			<div class="guarantee">
				<span class="stamp" aria-hidden="true"><b>30</b>dagars<br />garanti</span>
				<p class="desc">
					<strong>Nöjdhetsgaranti i 30 dagar.</strong> Avslutar du inom 30 dagar får du tillbaka din första
					månadsavgift. Gäller inte läkemedel eller prover. <a href={`${VELORA}/anvandarvillkor`}>Villkor</a>
				</p>
			</div>
			<!-- Entry 158: the switching block from "Passar Velora dig?", repeated under the guarantee. -->
			<div class="switch-row"><SwitchBlock /></div>
		</div>
	</div>
</section>

<style>
	/* Mobile: Velorametoden, Underhåll, then the cost table, stacked. */
	.plans {
		display: grid;
		gap: 16px;
		margin-top: 64px;
	}

	.plan-name {
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--ink-soft);
	}

	.unit {
		font-family: var(--sans);
		font-size: 0.8125rem;
		font-weight: 500;
		letter-spacing: 0;
		color: var(--ink-soft);
	}

	.small {
		font-size: 0.8125rem;
		color: var(--ink-soft);
	}

	.checks {
		list-style: none;
		margin: 0;
		padding: 24px 0 0;
		border-top: 1px solid var(--line);
		display: grid;
		gap: 14px;
	}

	.checks li {
		display: grid;
		grid-template-columns: 20px 1fr;
		gap: 12px;
		align-items: start;
		font-size: 0.9375rem;
		line-height: 1.45;
	}

	.check {
		display: flex;
		padding-top: 1px;
		color: var(--wine);
	}

	.check :global(svg) {
		width: 20px;
		height: 20px;
	}

	.price {
		font-family: var(--serif);
		font-weight: 300;
		font-size: clamp(4.5rem, 12vw, 7rem);
		line-height: 0.9;
		letter-spacing: -0.04em;
		white-space: nowrap;
	}

	.price .unit {
		font-size: 1rem;
	}

	/* ---- The two plan cards: same structure, wine and white ---- */
	.featured,
	.maintenance {
		border-radius: var(--radius);
		display: flex;
		flex-direction: column;
		gap: 28px;
		padding: 32px 24px;
	}

	.featured {
		background: var(--wine);
		color: var(--on-dark);
		--ink-soft: var(--on-dark-soft);
		--line: var(--line-dark);
	}

	.featured .check {
		color: var(--rose);
	}

	.maintenance {
		background: var(--card);
	}

	/* Entry 93: a step below Velorametoden's price, so the main plan stays the lead. */
	.maintenance .price {
		font-size: clamp(3rem, 8vw, 4.25rem);
	}

	.intro {
		margin-top: -12px;
		font-size: 0.9375rem;
		color: var(--ink-soft);
		max-width: 40ch;
	}

	/* The note (and, on the wine card, the booking button) sit at the foot, so the cards line up. */
	.featured-foot,
	.foot {
		margin-top: auto;
	}

	.featured-foot {
		display: grid;
		gap: 20px;
		justify-items: start;
	}

	/* ---- Cost table (after "Våra planer i detalj"): no card, ruled rows on the section ---- */
	/* Entry 90: narrower than the plan cards and centered beneath them. */
	.costs {
		max-width: 880px;
		margin: 56px auto 0;
	}

	.costs-head {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 4px 16px;
		flex-wrap: wrap;
		padding-bottom: 12px;
	}

	.costs-title {
		font-weight: 600;
		font-size: 0.9375rem;
	}

	.aside,
	.when {
		font-family: var(--serif);
		font-style: italic;
		font-weight: 400;
		color: var(--ink-soft);
	}

	.aside {
		font-size: 0.9375rem;
	}

	dl,
	dd {
		margin: 0;
	}

	/*
	 * Mobile: name and amount on one line, the explanation beneath. When both don't fit, the amount
	 * wraps to its own right-aligned line instead of breaking the name.
	 */
	.row {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 4px 16px;
		padding: 16px 0;
		border-top: 1px solid var(--line);
	}

	dt {
		flex: 1 0 auto;
		font-size: 1.0625rem;
		font-weight: 500;
		white-space: nowrap;
	}

	.when {
		margin-left: 6px;
		font-size: 0.9375rem;
		white-space: nowrap;
	}

	.amount {
		font-family: var(--serif);
		font-weight: 340;
		font-size: 1.25rem;
		letter-spacing: -0.01em;
		white-space: nowrap;
		text-align: right;
		margin-left: auto;
	}

	.desc {
		font-size: 0.8125rem;
		line-height: 1.5;
		color: var(--ink-soft);
		max-width: 52ch;
	}

	.row .desc {
		flex-basis: 100%;
		order: 1;
	}

	.desc a,
	.desc strong {
		color: var(--ink);
		font-weight: 600;
	}

	/* Entry 90: the stamp and its text centered as one group under the table. */
	.guarantee {
		display: flex;
		justify-content: center;
		align-items: center;
		gap: 20px;
		padding-top: 24px;
		border-top: 1px solid var(--line);
	}

	.guarantee .desc {
		max-width: 46ch;
	}

	/* Entry 158: centred under the guarantee, like it, as one left-ruled block. */
	.switch-row {
		display: flex;
		justify-content: center;
		margin-top: 40px;
	}

	.switch-row :global(.switch) {
		max-width: 46ch;
	}

	/* A rubber stamp for the guarantee: double ring, slight tilt. */
	.stamp {
		flex: none;
		display: inline-flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		width: 96px;
		height: 96px;
		border: 1.5px solid var(--wine);
		border-radius: 50%;
		outline: 1px solid var(--wine);
		outline-offset: -6px;
		transform: rotate(-8deg);
		color: var(--wine);
		font-size: 0.625rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		line-height: 1.3;
		text-align: center;
		text-transform: uppercase;
	}

	.stamp b {
		font-family: var(--serif);
		font-size: 1.75rem;
		font-weight: 400;
		letter-spacing: -0.02em;
		line-height: 1;
		text-transform: none;
	}

	/* Tablet+: the table gets its columns (the plans stay stacked until 1024 px, where the button fits). */
	@media (min-width: 768px) {
		.featured,
		.maintenance {
			padding: 40px;
		}

		/* Name | explanation | amount, like a plan-comparison table. */
		.row,
		.costs-head {
			display: grid;
			grid-template-columns: minmax(0, 3fr) minmax(0, 5fr) minmax(0, 3fr);
			column-gap: 28px;
		}

		dt {
			white-space: normal;
		}

		.row .desc {
			grid-column: 2;
			grid-row: 1;
			order: 0;
		}

		.amount {
			margin-left: 0;
		}

		.costs-head .aside {
			grid-column: 3;
			text-align: right;
		}
	}

	/* Tablets: a wider amount column so "ca 1 050–4 800 kr/mån" stays on one line. */
	@media (min-width: 768px) and (max-width: 1023px) {
		.row,
		.costs-head {
			grid-template-columns: minmax(0, 3fr) minmax(0, 4fr) minmax(0, 4fr);
		}
	}

	/* Desktop: the two plans side by side, equal width and height. */
	@media (min-width: 1024px) {
		.plans {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
			gap: 20px;
		}

		.featured,
		.maintenance {
			padding: 48px;
		}

		/*
		 * Entry 95: side by side, the Underhåll price is exactly as small as it must be for both
		 * checklist dividers to line up. Its line box (0.9 × size) plus the intro block (−12 px pull-up
		 * + 28 px gap = 16 px, then two 24 px lines) must equal Velorametoden's price line (0.9 × 7rem):
		 * 0.9 × size + 4rem = 0.9 × 7rem, so size = (6.3rem − 4rem) / 0.9 ≈ 41 px.
		 */
		.maintenance .price {
			font-size: calc((7rem * 0.9 - 4rem) / 0.9);
		}
	}
</style>
