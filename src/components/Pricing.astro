---
import { VELORA } from '../data/site';
import CtaButton from './CtaButton.astro';
---

<section class="section stone" id="pris" aria-labelledby="price-title">
	<div class="container">
		<div data-reveal>
			<p class="label">Pris</p>
			<h2 id="price-title">Hela kostnaden. <em>Inga dolda avgifter.</em></h2>
		</div>

		<div class="grid">
			<div class="plan" data-reveal data-plan-card>
				<!-- Two-option plan switch (entry 64): tabs pattern. Shown by JS; without it both plans are listed. -->
				<div class="plan-tabs" role="tablist" aria-label="Välj abonnemang" data-plan-tabs hidden>
					<button type="button" role="tab" id="tab-standard" aria-controls="plan-standard" aria-selected="true" data-tab="standard">
						Velorametoden
					</button>
					<button type="button" role="tab" id="tab-underhall" aria-controls="plan-underhall" aria-selected="false" tabindex="-1" data-tab="underhall">
						Underhåll
					</button>
				</div>

				<div class="plan-body" id="plan-standard" role="tabpanel" aria-labelledby="tab-standard" data-plan="standard">
					<p class="plan-name no-js-only">Velorametoden</p>
					<p class="price"><span class="from">från</span> 795<span class="unit"> kr/mån</span></p>
					<ul role="list">
						<li>Din egen läkare, expert på medicinsk viktnedgång</li>
						<li>Personlig coach och dietist</li>
						<li>Tillgång dygnet runt till vår webbapp för stöd och rådgivning</li>
					</ul>
					<p class="small">Du kan välja upplägg utan bindningstid. Studerar du på heltid: 695 kr/mån.</p>
				</div>

				<!-- Velora Underhåll, as described on velora.se (docs/facts.md). -->
				<div class="plan-body" id="plan-underhall" role="tabpanel" aria-labelledby="tab-underhall" data-plan="underhall">
					<p class="plan-name no-js-only">Velora Underhåll</p>
					<p class="intro">När du uppnått din målvikt och vill bygga vidare på dina framgångar.</p>
					<p class="price">495<span class="unit"> kr/mån</span></p>
					<ul role="list">
						<li>Hjälp med att behålla din målvikt</li>
						<li>Optimerad läkemedelsdosering för lägre kostnad</li>
						<li>Fortsatt support från hela Veloras expertteam</li>
						<li>Flexibelt upplägg utan bindningstid</li>
					</ul>
					<p class="small">Kostnaden för läkemedel ingår inte i priset.</p>
				</div>

				<CtaButton />
			</div>

			<div class="extra" data-reveal>
				<p class="plan-name">Det här tillkommer</p>
				<dl>
					<div>
						<dt>Hälsokontroll, innan start</dt>
						<dd class="amount">995 kr</dd>
						<dd class="desc">Blodprover och läkargenomgång. Har du nyligen tagit proverna betalar du bara för genomgången, 495 kr.</dd>
					</div>
					<div>
						<dt>Läkemedel, köps på apotek</dt>
						<dd class="amount">ca 1 050–4 800 kr/mån</dd>
						<dd class="desc">
							Beror på läkemedel och dos (oktober 2026). Försäkringskassan kan ersätta upp till 3 343 kr/mån. Vi
							hjälper dig med ett utlåtande, men kan inte garantera beslutet.
						</dd>
					</div>
					<div>
						<dt>Nöjdhetsgaranti i 30 dagar</dt>
						<dd class="desc">
							Avslutar du inom 30 dagar får du tillbaka din första månadsavgift. Gäller inte läkemedel eller prover.{' '}
							<a href={`${VELORA}/anvandarvillkor`}>Villkor</a>
						</dd>
					</div>
				</dl>
				<p class="small">När du nått din målvikt: Velora Underhåll, 495 kr/mån.</p>
			</div>
		</div>
	</div>
</section>

<script>
	document.querySelectorAll<HTMLElement>('[data-plan-card]').forEach((card) => {
		const tablist = card.querySelector<HTMLElement>('[data-plan-tabs]')!;
		const tabs = [...tablist.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
		const panels = [...card.querySelectorAll<HTMLElement>('[data-plan]')];

		const select = (index: number, focus = false) => {
			tabs.forEach((tab, i) => {
				const active = i === index;
				tab.setAttribute('aria-selected', String(active));
				tab.tabIndex = active ? 0 : -1;
				panels[i].hidden = !active;
			});
			tablist.dataset.active = String(index);
			if (focus) tabs[index].focus();
		};

		tabs.forEach((tab, i) => {
			tab.addEventListener('click', () => select(i));
			tab.addEventListener('keydown', (e) => {
				const keys: Record<string, number> = { ArrowRight: i + 1, ArrowLeft: i - 1, Home: 0, End: tabs.length - 1 };
				if (!(e.key in keys)) return;
				e.preventDefault();
				select((keys[e.key] + tabs.length) % tabs.length, true);
			});
		});

		card.classList.add('has-switch');
		tablist.hidden = false;
		select(0);
	});
</script>

<style>
	.grid {
		display: grid;
		gap: 20px;
		margin-top: 64px;
	}

	.plan,
	.extra {
		border-radius: var(--radius);
		padding: 32px 24px;
	}

	.plan {
		background: var(--card);
		display: grid;
		gap: 24px;
		align-content: start;
	}

	.extra {
		border: 1px solid var(--line);
	}

	.plan-body {
		display: grid;
		gap: 24px;
	}

	/* The display values here would otherwise override the hidden attribute. */
	.plan-body[hidden],
	.plan-tabs[hidden] {
		display: none;
	}

	.intro {
		font-size: 0.9375rem;
		color: var(--ink-soft);
	}

	/* With JS the tabs name the plan; the label is only for the no-JS listing. */
	.has-switch .no-js-only {
		display: none;
	}

	/* Large two-option switch: a deep wine indicator slides behind the selected plan. */
	.plan-tabs {
		position: relative;
		display: grid;
		grid-template-columns: 1fr 1fr;
		padding: 4px;
		border: 1px solid var(--line);
		border-radius: 999px;
		background: var(--stone);
	}

	.plan-tabs::before {
		content: '';
		position: absolute;
		top: 4px;
		bottom: 4px;
		left: 4px;
		width: calc(50% - 4px);
		border-radius: 999px;
		background: var(--wine);
		transition: transform 320ms var(--ease);
	}

	.plan-tabs[data-active='1']::before {
		transform: translateX(100%);
	}

	.plan-tabs button {
		all: unset;
		box-sizing: border-box;
		position: relative;
		z-index: 1;
		display: grid;
		place-items: center;
		min-height: 48px;
		padding: 0 12px;
		border-radius: 999px;
		font-size: 0.9375rem;
		font-weight: 600;
		text-align: center;
		color: var(--ink-soft);
		cursor: pointer;
		transition: color 320ms var(--ease);
	}

	.plan-tabs button[aria-selected='true'] {
		color: var(--cream);
	}

	.plan-tabs button:focus-visible {
		outline: 2px solid var(--wine);
		outline-offset: 3px;
	}

	@media (prefers-reduced-motion: reduce) {
		.plan-tabs::before,
		.plan-tabs button {
			transition: none;
		}
	}

	.plan-name {
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--ink-soft);
	}

	.price {
		font-family: var(--serif);
		font-weight: 300;
		font-size: clamp(4.5rem, 14vw, 6.5rem);
		line-height: 0.9;
		letter-spacing: -0.04em;
	}

	.from,
	.unit {
		font-family: var(--sans);
		font-size: 1rem;
		font-weight: 500;
		letter-spacing: 0;
		color: var(--ink-soft);
	}

	.plan ul {
		list-style: none;
		padding: 0;
		margin: 0;
		border-top: 1px solid var(--line);
	}

	.plan li {
		padding: 14px 0;
		border-bottom: 1px solid var(--line);
		font-size: 0.9375rem;
	}

	.small {
		font-size: 0.875rem;
		color: var(--ink-soft);
	}

	dl {
		margin: 8px 0 24px;
	}

	dl > div {
		padding: 22px 0;
		border-bottom: 1px solid var(--line);
		display: grid;
		gap: 6px;
	}

	dt {
		font-weight: 600;
	}

	dd {
		margin: 0;
	}

	.amount {
		font-family: var(--serif);
		font-weight: 340;
		font-size: 1.75rem;
		letter-spacing: -0.01em;
	}

	.desc {
		font-size: 0.875rem;
		color: var(--ink-soft);
	}

	.desc a {
		color: var(--ink);
		font-weight: 600;
	}

	@media (min-width: 1024px) {
		.grid {
			grid-template-columns: 1fr 1fr;
			gap: 32px;
		}

		.plan,
		.extra {
			padding: 48px;
		}
	}
</style>
