---
// Range + premises, never a single promise. Figures from velora.se FAQ:
// ~10 % in the first 4 months, 16–25 % over the first 12 months (study averages).
const DEFAULT_WEIGHT = 100;
---

<section class="section dark" aria-labelledby="calc-title">
	<div class="container grid">
		<div data-reveal>
			<p class="label">Vad du kan förvänta dig</p>
			<h2 id="calc-title">Ett räkneexempel, <em>inte ett löfte.</em></h2>
			<p class="lede">Dra i reglaget för att se vad genomsnitten från stora studier skulle betyda för dig.</p>
		</div>

		<div class="panel" data-calc data-reveal>
			<label for="weight" class="row">
				<span>Din vikt i dag</span>
				<output for="weight" class="weight" data-weight>{DEFAULT_WEIGHT} kg</output>
			</label>
			<!-- Pointer drags are handled on this wrapper so the thumb can ease after the finger (entry 74). -->
			<div class="track" data-track>
				<input id="weight" type="range" min="70" max="180" step="any" value={DEFAULT_WEIGHT} aria-valuetext={`${DEFAULT_WEIGHT} kg`} data-input />
			</div>
			<p class="visually-hidden" aria-live="polite" data-live></p>

			<dl class="results">
				<div>
					<dt>Efter ungefär 4 månader</dt>
					<dd class="value"><span data-four>ca 10</span> kg</dd>
					<dd class="basis">Omkring 10 % av kroppsvikten</dd>
				</div>
				<div>
					<dt>Efter 12 månader</dt>
					<dd class="value"><span data-twelve>16–25</span> kg</dd>
					<dd class="basis">16–25 % av kroppsvikten, beroende på läkemedel</dd>
				</div>
			</dl>

			<button type="button" class="premises-open" aria-haspopup="dialog" aria-controls="premises" data-premises-open>
				Vad bygger siffrorna på?
			</button>

			<dialog class="premises" id="premises" aria-labelledby="premises-title" data-premises data-lenis-prevent>
				<div class="sheet">
					<p class="premises-title" id="premises-title">Det här bygger siffrorna på</p>
					<ul role="list">
						<li>Genomsnitt i stora studier. Din viktnedgång kan bli större eller mindre.</li>
						<li>Medicinen kombineras med förändrade vanor kring mat och rörelse.</li>
						<li>Viktnedgången går oftast snabbast i början.</li>
						<li>Din läkare bedömer om behandling passar dig, och vilken.</li>
					</ul>
					<p class="footnote">Källa: velora.se, vanliga frågor om behandlingen.</p>
					<button type="button" class="premises-close" data-premises-close>Stäng</button>
				</div>
			</dialog>
		</div>
	</div>
</section>

<script>
	const fmt = new Intl.NumberFormat('sv-SE', { maximumFractionDigits: 0 });

	document.querySelectorAll<HTMLElement>('[data-calc]').forEach((root) => {
		const input = root.querySelector<HTMLInputElement>('[data-input]')!;
		const weight = root.querySelector<HTMLElement>('[data-weight]')!;
		const four = root.querySelector<HTMLElement>('[data-four]')!;
		const twelve = root.querySelector<HTMLElement>('[data-twelve]')!;

		const live = root.querySelector<HTMLElement>('[data-live]')!;
		const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
		const MIN = Number(input.min);
		const MAX = Number(input.max);

		// The thumb moves continuously (step="any"); the calculation uses the whole kilogram, as before.
		const targets = (kg: number) => ({ four: kg * 0.1, low: kg * 0.16, high: kg * 0.25 });
		let shown = targets(Number(input.value));
		let goal = shown;
		let frame = 0;

		const render = () => {
			four.textContent = `ca ${fmt.format(shown.four)}`;
			twelve.textContent = `${fmt.format(shown.low)}–${fmt.format(shown.high)}`;
		};

		// Results glide towards their new values instead of jumping.
		const tick = () => {
			let settled = true;
			for (const key of ['four', 'low', 'high'] as const) {
				const diff = goal[key] - shown[key];
				if (Math.abs(diff) < 0.05) {
					shown = { ...shown, [key]: goal[key] };
				} else {
					shown = { ...shown, [key]: shown[key] + diff * 0.2 };
					settled = false;
				}
			}
			render();
			frame = settled ? 0 : requestAnimationFrame(tick);
		};

		const update = () => {
			const raw = Number(input.value);
			const kg = Math.round(raw);
			input.style.setProperty('--fill', `${((raw - MIN) / (MAX - MIN)) * 100}%`);
			input.setAttribute('aria-valuetext', `${kg} kg`);
			weight.textContent = `${fmt.format(kg)} kg`;
			goal = targets(kg);
			if (reduced.matches) {
				shown = goal;
				render();
			} else if (!frame) {
				frame = requestAnimationFrame(tick);
			}
		};

		// Screen readers hear the result once, when the value is committed, not on every movement.
		const announce = () => {
			const kg = Math.round(Number(input.value));
			const t = targets(kg);
			live.textContent = `${kg} kg: efter ungefär 4 månader ca ${fmt.format(t.four)} kg, efter 12 månader ${fmt.format(t.low)}–${fmt.format(t.high)} kg.`;
		};

		/*
		 * Eased dragging (entry 74). The pointer sets a target and the thumb follows on a critically
		 * damped spring: it speeds up when you start moving, slows into place when you stop, and a
		 * quick flick glides a little further, like momentum scrolling. No overshoot past the target.
		 */
		const track = root.querySelector<HTMLElement>('[data-track]')!;
		const THUMB = 28;
		const STIFFNESS = 320;
		const DAMPING = 2 * Math.sqrt(STIFFNESS);
		const FLING_MS = 90;
		const FLING_MAX_PX = 56;
		const clamp = (v: number) => Math.min(MAX, Math.max(MIN, v));
		let pos = Number(input.value);
		let vel = 0;
		let target = pos;
		let springFrame = 0;
		let last = 0;
		let dragging = false;
		let grabOffset = 0;
		let lastMove = { x: 0, t: 0 };
		let pointerVel = 0;

		const valueAt = (clientX: number) => {
			const rect = input.getBoundingClientRect();
			return clamp(MIN + ((clientX - rect.left - THUMB / 2) / (rect.width - THUMB)) * (MAX - MIN));
		};
		const thumbX = () => {
			const rect = input.getBoundingClientRect();
			return rect.left + THUMB / 2 + ((pos - MIN) / (MAX - MIN)) * (rect.width - THUMB);
		};

		const step = (now: number) => {
			const dt = Math.min(0.032, (now - last) / 1000 || 0.016);
			last = now;
			vel += (STIFFNESS * (target - pos) - DAMPING * vel) * dt;
			pos = clamp(pos + vel * dt);
			if ((pos === MIN && vel < 0) || (pos === MAX && vel > 0)) vel = 0;
			const settled = !dragging && Math.abs(target - pos) < 0.01 && Math.abs(vel) < 0.05;
			if (settled) pos = target;
			input.value = String(pos);
			update();
			if (settled) {
				springFrame = 0;
				announce();
			} else {
				springFrame = requestAnimationFrame(step);
			}
		};
		const moveTo = (value: number) => {
			target = clamp(value);
			if (reduced.matches) {
				pos = target;
				vel = 0;
				input.value = String(pos);
				update();
				return;
			}
			if (!springFrame) {
				last = performance.now();
				springFrame = requestAnimationFrame(step);
			}
		};

		track.addEventListener('pointerdown', (e) => {
			if (e.button !== 0) return;
			e.preventDefault();
			input.focus({ preventScroll: true });
			track.setPointerCapture(e.pointerId);
			dragging = true;
			track.classList.add('is-dragging');
			// Grabbing the thumb keeps it under the pointer; a press elsewhere on the track glides there.
			grabOffset = Math.abs(e.clientX - thumbX()) <= THUMB ? thumbX() - e.clientX : 0;
			lastMove = { x: e.clientX, t: e.timeStamp };
			pointerVel = 0;
			moveTo(valueAt(e.clientX + grabOffset));
		});
		track.addEventListener('pointermove', (e) => {
			if (!dragging) return;
			const dt = e.timeStamp - lastMove.t;
			if (dt > 0) pointerVel = pointerVel * 0.6 + ((e.clientX - lastMove.x) / dt) * 0.4;
			lastMove = { x: e.clientX, t: e.timeStamp };
			moveTo(valueAt(e.clientX + grabOffset));
		});
		const release = (e: PointerEvent) => {
			if (!dragging) return;
			dragging = false;
			track.classList.remove('is-dragging');
			// A flick carries on briefly; a slow release (or a pause before letting go) stays put.
			const fresh = e.timeStamp - lastMove.t < 80;
			const glidePx = fresh ? Math.max(-FLING_MAX_PX, Math.min(FLING_MAX_PX, pointerVel * FLING_MS)) : 0;
			moveTo(valueAt(lastMove.x + grabOffset + glidePx));
		};
		track.addEventListener('pointerup', release);
		track.addEventListener('pointercancel', release);

		// step="any" would make arrow keys move in tiny increments; keep whole-kilogram keyboard steps.
		input.addEventListener('keydown', (e) => {
			const now = Math.round(Number(input.value));
			const next = { ArrowRight: now + 1, ArrowUp: now + 1, ArrowLeft: now - 1, ArrowDown: now - 1, PageUp: now + 10, PageDown: now - 10, Home: MIN, End: MAX }[e.key];
			if (next === undefined) return;
			e.preventDefault();
			input.value = String(Math.min(MAX, Math.max(MIN, next)));
			pos = target = Number(input.value);
			vel = 0;
			update();
			announce();
		});

		// Assistive tech can still set the value directly; keep the spring in sync with it.
		input.addEventListener('input', () => {
			pos = target = Number(input.value);
			vel = 0;
			update();
		});
		// The thumb stays where it is released (no snap); the label already shows the whole kilogram.
		input.addEventListener('change', announce);
		update();

		// Premises overlay: native <dialog> gives focus trapping, Escape to close and focus return.
		const dialog = root.querySelector<HTMLDialogElement>('[data-premises]')!;
		root.querySelector('[data-premises-open]')!.addEventListener('click', () => dialog.showModal());
		dialog.querySelector('[data-premises-close]')!.addEventListener('click', () => dialog.close());
		// A click on the dimmed backdrop (the dialog element itself, outside the sheet) closes it.
		dialog.addEventListener('click', (e) => {
			if (e.target === dialog) dialog.close();
		});
	});
</script>

<style>
	.grid {
		display: grid;
		gap: 56px;
	}

	.row {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		font-size: 0.8125rem;
		font-weight: 600;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--on-dark-soft);
	}

	.weight {
		font-family: var(--serif);
		font-size: 2.5rem;
		font-weight: 300;
		letter-spacing: -0.02em;
		text-transform: none;
		color: var(--on-dark);
	}

	/* The wrapper takes pointer input; vertical swipes still scroll the page on touch screens. */
	.track {
		margin: 24px 0 16px;
		cursor: grab;
		touch-action: pan-y;
		user-select: none;
		-webkit-user-select: none;
	}

	.track.is-dragging {
		cursor: grabbing;
	}

	input[type='range'] {
		--fill: 27%;
		display: block;
		width: 100%;
		margin: 0;
		pointer-events: none;
		height: 36px;
		appearance: none;
		background: transparent;
	}

	input[type='range']::-webkit-slider-runnable-track {
		height: 2px;
		background: linear-gradient(to right, var(--on-dark) var(--fill), var(--line-dark) var(--fill));
	}

	input[type='range']::-moz-range-track {
		height: 2px;
		background: linear-gradient(to right, var(--on-dark) var(--fill), var(--line-dark) var(--fill));
	}

	input[type='range']::-webkit-slider-thumb {
		appearance: none;
		width: 28px;
		height: 28px;
		margin-top: -13px;
		border-radius: 50%;
		background: var(--cream);
		box-shadow: 0 0 0 6px rgba(247, 242, 236, 0.12);
	}

	input[type='range']::-moz-range-thumb {
		width: 28px;
		height: 28px;
		border: 0;
		border-radius: 50%;
		background: var(--cream);
	}

	input[type='range']:focus-visible {
		outline: none;
	}

	input[type='range']:focus-visible::-webkit-slider-thumb {
		box-shadow: 0 0 0 3px var(--wine), 0 0 0 5px var(--cream);
	}

	.results {
		display: grid;
		/* minmax(0, …) lets the cells shrink below the numbers' natural width instead of overflowing. */
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 20px;
		margin: 24px 0 0;
	}

	.results > div {
		container-type: inline-size;
	}

	dt {
		font-size: 0.8125rem;
		color: var(--on-dark-soft);
	}

	dd {
		margin: 0;
	}

	.value {
		margin: 10px 0 8px;
		font-family: var(--serif);
		font-weight: 300;
		/*
		 * The widest full result ("16–25 kg", including " kg") measures ~3.9em, so 100cqi / 4.1 caps the
		 * size to the cell. Where that cap is larger, the original viewport-based size applies unchanged.
		 */
		font-size: min(clamp(2.125rem, 9vw, 4.5rem), 100cqi / 4.1);
		line-height: 1;
		letter-spacing: -0.03em;
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}

	.value span {
		color: var(--rose);
	}

	.basis {
		font-size: 0.8125rem;
		line-height: 1.45;
		color: var(--on-dark-soft);
	}

	.premises-open {
		all: unset;
		box-sizing: border-box;
		display: inline-flex;
		align-items: center;
		gap: 10px;
		margin-top: 40px;
		min-height: 44px;
		padding: 0 20px;
		border: 1px solid var(--line);
		border-radius: 999px;
		font-size: 0.9375rem;
		font-weight: 600;
		color: var(--on-dark);
		cursor: pointer;
		transition:
			background-color 240ms var(--ease),
			border-color 240ms var(--ease);
	}

	.premises-open::before {
		content: 'i';
		display: grid;
		place-items: center;
		width: 20px;
		height: 20px;
		border: 1px solid currentColor;
		border-radius: 50%;
		font-family: var(--serif);
		font-style: italic;
		font-size: 0.8125rem;
		font-weight: 400;
	}

	.premises-open:hover {
		background: rgba(247, 242, 236, 0.08);
		border-color: var(--on-dark-soft);
	}

	.premises-open:focus-visible {
		outline: 2px solid var(--on-dark);
		outline-offset: 4px;
	}

	/* Overlay: a cream sheet over the dimmed page, the inverse of the dark section it opens from. */
	.premises {
		width: min(520px, calc(100% - 32px));
		max-height: calc(100svh - 32px);
		padding: 0;
		border: 0;
		border-radius: var(--radius);
		background: var(--cream);
		color: var(--ink);
		--ink-soft: #6b5560;
	}

	.premises::backdrop {
		background: rgba(44, 0, 21, 0.62);
		backdrop-filter: blur(4px);
	}

	.premises[open] {
		animation: rise 360ms var(--ease);
	}

	.premises[open]::backdrop {
		animation: fade 360ms var(--ease);
	}

	@keyframes rise {
		from {
			opacity: 0;
			transform: translateY(16px);
		}
	}

	@keyframes fade {
		from {
			opacity: 0;
		}
	}

	.sheet {
		padding: 32px 28px 28px;
	}

	.premises-title {
		font-family: var(--serif);
		font-weight: 340;
		font-size: 1.75rem;
		line-height: 1.15;
		margin-bottom: 18px;
	}

	.premises ul {
		margin: 0 0 18px;
		padding-left: 1.1em;
		color: var(--ink-soft);
		font-size: 0.9375rem;
		display: grid;
		gap: 8px;
	}

	.premises-close {
		all: unset;
		box-sizing: border-box;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		margin-top: 24px;
		min-height: 48px;
		padding: 0 24px;
		border-radius: 999px;
		background: var(--wine);
		color: var(--cream);
		font-weight: 600;
		font-size: 0.9375rem;
		cursor: pointer;
	}

	.premises-close:focus-visible {
		outline: 2px solid var(--wine);
		outline-offset: 3px;
	}

	@media (prefers-reduced-motion: reduce) {
		.premises[open],
		.premises[open]::backdrop {
			animation: none;
		}
	}

	@media (min-width: 1024px) {
		.grid {
			grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
			gap: 96px;
			align-items: start;
		}
	}
</style>
