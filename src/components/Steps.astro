---
import videoIcon from '@phosphor-icons/core/assets/light/video-camera-light.svg?raw';
import dropIcon from '@phosphor-icons/core/assets/light/drop-light.svg?raw';
import planIcon from '@phosphor-icons/core/assets/light/clipboard-text-light.svg?raw';
import chatIcon from '@phosphor-icons/core/assets/light/chats-circle-light.svg?raw';
import { CTA, IMG } from '../data/site';
import CtaButton from './CtaButton.astro';

// The 4-step version from velora.se/om-oss. Entry 213: the bento (entry 61) read as confusing in
// feedback sessions (which tile comes next?), so the steps are now one line of equal tiles, read top
// to bottom on phones and left to right on desktop. Entry 214: the number sits inside each tile again
// and the tiles keep the bento's colours (white, white, rose, wine). The photo of the first step sits
// beside the heading instead of inside a tile.
const steps = [
	{
		icon: videoIcon,
		title: 'Gratis bedömningssamtal',
		text: 'Du svarar på några korta frågor och träffar sedan en läkare eller sjuksköterska i ett videomöte. Ni går igenom din hälsa, tidigare försök och vad du vill uppnå. Kostnadsfritt, och du binder dig inte till något.',
	},
	{
		icon: dropIcon,
		title: 'Hälsokontroll',
		text: 'Du lämnar blodprover på något av fler än 165 provtagningsställen. En läkare går igenom svaren, så att behandlingen är säker för dig.',
	},
	{
		icon: planIcon,
		title: 'Din personliga plan',
		text: 'Du får en medicinsk plan gjord för dig, med stöd från dietist och coach för vanor som håller i vardagen.',
	},
	{
		icon: chatIcon,
		title: 'Vi finns kvar hela vägen',
		text: 'Regelbundna avstämningar, och du kan skriva till ditt vårdteam när som helst. Behandlingen anpassas när livet eller kroppen förändras.',
	},
];
---

<section class="section stone" id="sa-fungerar-det" aria-labelledby="steps-title">
	<div class="container">
		<div class="head" data-reveal>
			<div class="head-text">
				<p class="label">Så går det till</p>
				<h2 id="steps-title">Från första samtal till <em>långsiktig</em> uppföljning.</h2>
				<p class="lede">Fyra steg, allt via video och chatt, var du än bor i Sverige. Det enda du gör på plats är ett blodprov.</p>
			</div>
			<img
				class="photo"
				src={IMG.videoMeeting}
				alt="Kvinna med hörlurar som pratar med en läkare via datorn i sitt kök"
				width="1024"
				height="683"
				loading="lazy"
			/>
		</div>

		<ol class="steps" role="list">
			{
				steps.map((s, i) => (
					<li class:list={['step', `s${i + 1}`]} data-reveal style={`transition-delay: ${i * 100}ms`}>
						<div class="top">
							<span class="icon" aria-hidden="true" set:html={s.icon} />
							<span class="num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
						</div>
						<h3>
							<span class="visually-hidden">Steg {i + 1}: </span>
							{s.title}
						</h3>
						<p>{s.text}</p>
					</li>
				))
			}
		</ol>

		<div class="steps-cta" data-reveal>
			<CtaButton label="Boka gratis bedömningssamtal" />
			<p class="note">{CTA.shortNote}</p>
		</div>
	</div>
</section>

<style>
	.head {
		display: grid;
		gap: 32px;
	}

	.head h2 {
		max-width: 14ch;
	}

	.photo {
		width: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
		border-radius: var(--radius);
	}

	/* Phones and tablets: one column in step order. */
	.steps {
		list-style: none;
		padding: 0;
		margin: 48px 0 0;
		display: grid;
		gap: 12px;
	}

	.step {
		padding: 24px;
		border-radius: var(--radius);
		background: var(--card);
	}

	.s3 {
		background: var(--rose);
	}

	.s4 {
		background: var(--wine);
		color: var(--on-dark);
	}

	/* Icon on the left, the step number on the right of the same row. */
	.top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 20px;
	}

	.icon {
		display: grid;
		place-items: center;
		width: 44px;
		height: 44px;
		border: 1px solid var(--line);
		border-radius: 50%;
		color: var(--wine);
	}

	.icon :global(svg) {
		width: 22px;
		height: 22px;
	}

	.s4 .icon {
		border-color: var(--line-dark);
		color: var(--rose);
	}

	.num {
		font-family: var(--serif);
		font-style: italic;
		font-size: 1.75rem;
		line-height: 1;
		color: var(--ink-soft);
	}

	h3 {
		margin: 0 0 10px;
		font-size: 1.5rem;
	}

	.step p {
		font-size: 0.9375rem;
		color: var(--ink-soft);
		max-width: 52ch;
	}

	/* Soft grey on rose is ~4.4:1, under AA for small text, so the rose tile uses ink. */
	.s3 .num,
	.s3 p {
		color: var(--ink);
	}

	.s4 .num,
	.s4 p {
		color: var(--on-dark-soft);
	}

	.steps-cta {
		display: grid;
		justify-items: center;
		gap: 12px;
		margin-top: 40px;
		text-align: center;
	}

	.steps-cta :global(.cta) {
		justify-items: center;
	}

	.note {
		font-size: 0.875rem;
		color: var(--ink-soft);
	}

	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	@media (min-width: 640px) {
		.photo {
			aspect-ratio: 16 / 9;
		}

		.step {
			padding: 28px 32px;
		}
	}

	/*
	 * Desktop: heading beside the photo; the four steps in one row of equal tiles, read left to right.
	 */
	@media (min-width: 1024px) {
		.head {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
			align-items: center;
			gap: 64px;
		}

		.photo {
			aspect-ratio: 3 / 2;
		}

		.steps {
			grid-template-columns: repeat(4, minmax(0, 1fr));
			gap: 20px;
			margin-top: 72px;
		}

		.step {
			padding: 28px;
		}
	}
</style>
