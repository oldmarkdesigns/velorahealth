---
import videoIcon from '@phosphor-icons/core/assets/light/video-camera-light.svg?raw';
import dropIcon from '@phosphor-icons/core/assets/light/drop-light.svg?raw';
import planIcon from '@phosphor-icons/core/assets/light/clipboard-text-light.svg?raw';
import chatIcon from '@phosphor-icons/core/assets/light/chats-circle-light.svg?raw';
import { CTA, IMG } from '../data/site';
import CtaButton from './CtaButton.astro';

// The 4-step version from velora.se/om-oss. Laid out as a bento (prompt log entry 61): the free
// call (step 1, where the CTA leads) is the large photo tile; steps 2–4 are icon tiles.
const steps = [
	{
		icon: videoIcon,
		title: 'Gratis bedömningssamtal',
		text: 'Du svarar på några korta frågor och träffar sedan en läkare eller sjuksköterska i ett videomöte. Ni går igenom din hälsa, tidigare försök och vad du vill uppnå. Kostnadsfritt, och du binder dig inte till något.',
	},
	{
		icon: dropIcon,
		title: 'Hälsokontroll',
		text: 'Du lämnar blodprover på något av fler än 165 provtagningsställen. En läkare går igenom svaren, så att behandlingen är säker för dig.',
	},
	{
		icon: planIcon,
		title: 'Din personliga plan',
		text: 'Du får en medicinsk plan gjord för dig, med stöd från dietist och coach för vanor som håller i vardagen.',
	},
	{
		icon: chatIcon,
		title: 'Vi finns kvar hela vägen',
		text: 'Regelbundna avstämningar, och du kan skriva till ditt vårdteam när som helst. Behandlingen anpassas när livet eller kroppen förändras.',
	},
];
const [first, ...rest] = steps;
---

<section class="section stone" id="sa-fungerar-det" aria-labelledby="steps-title">
	<div class="container">
		<div class="head" data-reveal>
			<p class="label">Så går det till</p>
			<h2 id="steps-title">Från första samtal till <em>långsiktig</em> uppföljning.</h2>
			<p class="lede">Allt sker via video och chatt, var du än bor i Sverige. Det enda du gör på plats är ett blodprov.</p>
		</div>

		<ol class="bento" role="list">
			<li class="tile t1" data-reveal>
				<img
					src={IMG.videoMeeting}
					alt="Kvinna med hörlurar som pratar med en läkare via datorn i sitt kök"
					width="1024"
					height="683"
					loading="lazy"
				/>
				<div class="copy">
					<span class="num">01</span>
					<h3>{first.title}</h3>
					<p>{first.text}</p>
				</div>
			</li>
			{
				rest.map((s, i) => (
					<li class:list={['tile', `t${i + 2}`]} data-reveal style={`transition-delay: ${(i + 1) * 100}ms`}>
						<span class="icon" aria-hidden="true" set:html={s.icon} />
						<span class="num">{String(i + 2).padStart(2, '0')}</span>
						<h3>{s.title}</h3>
						<p>{s.text}</p>
					</li>
				))
			}
			<!-- Booking tile beside step 04 (entry 87): narrower than 02 and 03 on desktop. -->
			<li class="tile cta-tile" data-reveal style="transition-delay: 400ms">
				<p class="cta-title">Börja med ett gratis samtal</p>
				<p class="cta-note">{CTA.shortNote}</p>
				<div class="cta-action"><CtaButton size="sm" label="Kom igång" /></div>
			</li>
		</ol>
	</div>
</section>

<style>
	.head h2 {
		max-width: 14ch;
	}

	/* Mobile: one column, photo tile first. */
	.bento {
		list-style: none;
		padding: 0;
		margin: 48px 0 0;
		display: grid;
		gap: 12px;
	}

	.tile {
		display: flex;
		flex-direction: column;
		padding: 28px 24px;
		border-radius: var(--radius);
	}

	.t1 {
		padding: 0;
		overflow: hidden;
		background: var(--card);
	}

	.t1 img {
		width: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
	}

	.t1 .copy {
		padding: 28px 24px;
	}

	.t2 {
		background: var(--card);
	}

	.t3 {
		background: var(--rose);
	}

	.t4 {
		background: var(--wine);
		color: var(--on-dark);
	}

	.icon {
		display: grid;
		place-items: center;
		width: 44px;
		height: 44px;
		margin-bottom: 20px;
		border: 1px solid var(--line);
		border-radius: 50%;
		color: var(--wine);
	}

	.icon :global(svg) {
		width: 22px;
		height: 22px;
	}

	.t4 .icon {
		border-color: var(--line-dark);
		color: var(--rose);
	}

	.num {
		font-family: var(--serif);
		font-style: italic;
		font-size: 0.9375rem;
		color: var(--ink-soft);
	}

	h3 {
		margin: 6px 0 10px;
		font-size: 1.5rem;
	}

	.tile p {
		font-size: 0.9375rem;
		color: var(--ink-soft);
		max-width: 52ch;
	}

	/* Soft grey on rose is ~4.4:1, under AA for small text, so the rose tile uses ink. */
	.t3 .num,
	.t3 p {
		color: var(--ink);
	}

	.t4 .num,
	.t4 p {
		color: var(--on-dark-soft);
	}

	/* Booking tile: white like step 02, wine button at the foot. */
	.cta-tile {
		background: var(--card);
	}

	/* Scoped under the tile so `.tile p` (step body text) doesn't win. */
	.cta-tile .cta-title {
		color: var(--ink);
		font-family: var(--serif);
		font-weight: 340;
		font-size: 1.5rem;
		line-height: 1.15;
	}

	.cta-tile .cta-note {
		margin-top: 10px;
		font-size: 0.875rem;
		color: var(--ink-soft);
	}

	.cta-action {
		margin-top: 24px;
	}

	/* Tablet: two columns, the photo tile across the top. */
	@media (min-width: 640px) {
		.bento {
			grid-template-columns: 1fr 1fr;
			gap: 16px;
		}

		.t1 {
			grid-column: span 2;
			display: grid;
			grid-template-columns: 1fr 1fr;
		}

		.t1 img {
			aspect-ratio: auto;
			height: 100%;
			min-height: 280px;
		}

		.t1 .copy {
			align-self: center;
		}

		.t4,
		.cta-tile {
			grid-column: span 2;
		}
	}

	/* Desktop: the photo tile tall on the left, steps 2–3 beside it, step 4 wide beneath them. */
	@media (min-width: 1024px) {
		.bento {
			/*
			 * Entry 87: steps 02 and 03 each span two tracks that add up to 1fr, so they stay equal; step 04
			 * spans three tracks and the booking tile the last, narrower one (0.8fr). minmax(0, …) keeps
			 * these proportions even when the button's width would otherwise widen its column.
			 */
			grid-template-columns:
				minmax(0, 1.25fr) minmax(0, 0.5fr) minmax(0, 0.5fr) minmax(0, 0.2fr)
				minmax(0, 0.8fr);
			margin-top: 64px;
		}

		.t1 {
			grid-column: 1;
			grid-row: span 2;
			display: flex;
		}

		.t1 img {
			height: 300px;
			min-height: 0;
		}

		.t1 .copy {
			align-self: auto;
			padding: 32px;
		}

		.tile:not(.t1) {
			padding: 32px;
		}

		.t2 {
			grid-column: 2 / 4;
		}

		.t3 {
			grid-column: 4 / 6;
		}

		.t4 {
			grid-column: 2 / 5;
		}

		.cta-tile {
			grid-column: 5;
			display: flex;
			flex-direction: column;
		}

		/* Slightly tighter than the step tiles so the button fits the narrow column at 1024 px. */
		.tile.cta-tile {
			padding: 28px 24px;
		}

		.cta-action {
			margin-top: auto;
			padding-top: 24px;
		}
	}
</style>
