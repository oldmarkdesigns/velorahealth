---
import { VELORA } from '../data/site';

// The real objections, answered in Velora's own wording (velora.se, /behandling, /om-oss).
const faqs = [
	{
		q: 'Vad händer i bedömningssamtalet?',
		a: 'Du fyller i ett kort formulär och träffar sedan en läkare eller sjuksköterska i ett videomöte. Ni går igenom hälsa, viktutveckling, tidigare försök, läkemedel och vad du vill uppnå. Det är helt gratis och du binder dig inte till något.',
	},
	{
		q: 'Behöver jag åka någonstans?',
		a: 'Nej. Alla möten med läkare, sjuksköterska, dietist och coach sker via video eller chatt. Det enda du gör på plats är blodprovet, som du lämnar på något av fler än 165 provtagningsställen i hela Sverige.',
	},
	{
		q: 'Finns det biverkningar?',
		a: 'Som vid all läkemedelsbehandling kan biverkningar förekomma. De är vanligtvis milda och övergående, oftast besvär från mage och tarm i början av behandlingen. Din läkare hjälper dig att mildra dem, till exempel genom att justera dosen.',
	},
	{
		q: 'Vilket läkemedel får jag?',
		a: 'Det avgör din läkare efter en personlig bedömning. Läkaren väljer det läkemedel som passar dig och din hälsa bäst, och sätter upp en individuell behandlingsplan.',
	},
];
---

<section class="section" aria-labelledby="faq-title">
	<div class="container grid">
		<div data-reveal>
			<p class="label">Vanliga frågor</p>
			<h2 id="faq-title">Bra att veta <em>innan</em> du bokar.</h2>
		</div>
		<div data-reveal>
			{
				faqs.map((f) => (
					<details>
						<summary>
							{f.q}
							<span class="sign" aria-hidden="true" />
						</summary>
						<p>{f.a}</p>
					</details>
				))
			}
			<a class="more" href={`${VELORA}/#vanliga-fragor`}>Fler frågor och svar på velora.se</a>
		</div>
	</div>
</section>

<style>
	.grid {
		display: grid;
		gap: 56px;
	}

	details {
		border-bottom: 1px solid var(--line);
	}

	details:first-of-type {
		border-top: 1px solid var(--line);
	}

	summary {
		list-style: none;
		cursor: pointer;
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 24px;
		padding: 26px 0;
		font-family: var(--serif);
		font-weight: 340;
		font-size: 1.5rem;
		line-height: 1.25;
	}

	summary::-webkit-details-marker {
		display: none;
	}

	.sign {
		position: relative;
		flex: none;
		width: 16px;
		height: 16px;
	}

	.sign::before,
	.sign::after {
		content: '';
		position: absolute;
		inset: 7.5px 0 auto;
		height: 1px;
		background: var(--wine);
		transition: transform 300ms var(--ease);
	}

	.sign::after {
		transform: rotate(90deg);
	}

	details[open] .sign::after {
		transform: rotate(0deg);
	}

	details p {
		padding-bottom: 28px;
		color: var(--ink-soft);
		max-width: 60ch;
	}

	.more {
		display: inline-block;
		margin-top: 28px;
		font-weight: 600;
	}

	@media (min-width: 1024px) {
		.grid {
			grid-template-columns: 5fr 7fr;
			gap: 96px;
		}
	}
</style>
