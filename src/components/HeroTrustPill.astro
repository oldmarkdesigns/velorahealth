---
// Entry 227: a downward trend line (as in the reference), not a plain down arrow.
import trendDown from '@phosphor-icons/core/assets/light/trend-down-light.svg?raw';
// Entry 230: the guarantee gets a badge (seal with a tick) in its own colours, instead of a plain tick.
import sealCheck from '@phosphor-icons/core/assets/light/seal-check-light.svg?raw';
import { IMG } from '../data/site';

// Frosted trust pill at the top of the hero's text stack (prompt log entries 33–35, 47).
// "Gå ner 20 % i vikt i snitt" is Samuel's wording (entries 47, 124); velora.se states 16–25 %, so it is
// flagged in docs/facts.md. Icons: Phosphor (light), bare, no circle.
// Entry 199: with `detailed` (the phone panel under the hero) each pill carries velora.se's mobile
// title and subtitle; the hero's one-row pill (tablet, desktop) keeps the short labels.
interface Props {
	detailed?: boolean;
	/* Entry 210: the second copy in the phone carousel's loop is decorative; screen readers skip it. */
	decorative?: boolean;
}

const { detailed = false, decorative = false } = Astro.props;
const items = [
	{ label: 'Eget vårdteam', title: 'Ditt eget vårdteam', sub: 'Obegränsad kontakt, hela vägen', avatars: true },
	{ label: 'Gå ner 20 % i vikt i snitt', title: 'Gå ner 20 % i vikt i snitt', sub: 'Med mindre hunger och sug', icon: trendDown },
	{ label: '30 dagars nöjdhetsgaranti', title: '30 dagars nöjdhetsgaranti', sub: 'Nöjd eller pengarna tillbaka', icon: sealCheck, badge: true },
];
// The care team's portraits stay beside the first statement (prompt log entry 34).
const team = [IMG.mina, IMG.daniel, IMG.sandra];
---

<aside class="pill" aria-label={decorative ? undefined : 'Det här får du hos Velora'} aria-hidden={decorative ? 'true' : undefined}>
	<ul role="list">
		{
			items.map((item) => (
				<li>
					{item.avatars && (
						<span class="avatars" aria-hidden="true">
							{team.map((src) => (
								<img src={src} alt="" width="32" height="32" loading="lazy" />
							))}
						</span>
					)}
					{item.icon && <span class:list={['icon', { badge: item.badge }]} aria-hidden="true" set:html={item.icon} />}
					{detailed ? (
						<span class="text">
							<span class="title">{item.title}</span>
							<span class="sub">{item.sub}</span>
						</span>
					) : (
						item.label
					)}
				</li>
			))
		}
	</ul>
</aside>

<style>
	/* Entry 199: title and subtitle stacked inside the same pill; the subtitle in the body face. */
	.text {
		display: grid;
		gap: 3px;
	}

	.sub {
		font-family: var(--sans);
		font-weight: 400;
		font-size: 0.8125rem;
		line-height: 1.2;
		letter-spacing: 0;
		color: var(--ink-soft);
	}

	/*
	 * One frosted pill holding all three statements (from 768 px). Phones (entries 145, 147): the
	 * three don't fit one row at 375 px, so each statement is its own pill, stacked and as wide as its
	 * content, with the same padding. They lead the hero's bottom-anchored text stack, so they land on
	 * the foot of the photo where it fades into cream.
	 */
	.pill,
	li {
		background: rgba(255, 253, 250, 0.6);
		backdrop-filter: blur(16px) saturate(140%);
		-webkit-backdrop-filter: blur(16px) saturate(140%);
		border: 1px solid var(--line);
		box-shadow: 0 16px 32px -24px rgba(82, 19, 36, 0.35);
	}

	.pill {
		display: block;
		margin-bottom: 24px;
		background: none;
		backdrop-filter: none;
		-webkit-backdrop-filter: none;
		border: 0;
		box-shadow: none;
	}

	@media (max-width: 767px) {
		/* .pill ul, so it outranks the base `ul` rule further down. */
		.pill ul {
			flex-direction: column;
			align-items: flex-start;
			gap: 8px;
		}

		/* Same padding in every pill: 6 px around the 28 px badge, 16 px after the text. */
		li {
			padding: 6px 16px 6px 6px;
			border-radius: 999px;
		}

		li + li::before {
			display: none;
		}

		.avatars img,
		.icon {
			width: 28px;
			height: 28px;
		}

		.icon :global(svg) {
			width: 16px;
			height: 16px;
		}
	}

	/* From 768 px: one row, a full pill. Sits on cream there, so a fine wine outline gives it its edge. */
	@media (min-width: 768px) {
		/* Entry 226: the pill and every item keep their content's width, so no label is cut off. */
		.pill {
			display: inline-block;
			width: max-content;
			max-width: 100%;
			margin-bottom: 28px;
			padding: 10px 24px 10px 10px;
			border-radius: 999px;
			background: rgba(255, 253, 250, 0.6);
			backdrop-filter: blur(16px) saturate(140%);
			-webkit-backdrop-filter: blur(16px) saturate(140%);
			border: 1px solid var(--line);
			box-shadow: 0 16px 32px -24px rgba(82, 19, 36, 0.35);
		}

		li {
			flex: none;
			background: none;
			backdrop-filter: none;
			-webkit-backdrop-filter: none;
			border: 0;
			box-shadow: none;
		}
	}

	/* Solid card colour instead of frost: on the separate pills (phones) or the one pill (768 px up). */
	@media (prefers-reduced-transparency: reduce) and (max-width: 767px) {
		li {
			background: var(--card);
			backdrop-filter: none;
			-webkit-backdrop-filter: none;
		}
	}

	@media (prefers-reduced-transparency: reduce) and (min-width: 768px) {
		.pill {
			background: var(--card);
			backdrop-filter: none;
			-webkit-backdrop-filter: none;
		}
	}

	ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		align-items: center;
	}

	li {
		display: flex;
		align-items: center;
		/* Entry 225: the button's type (body sans, 600, 15 px), not the hero serif. */
		font-family: var(--sans);
		font-weight: 600;
		font-size: 0.9375rem;
		line-height: 1;
		letter-spacing: 0.005em;
		white-space: nowrap;
	}

	/* Thin vertical divider between statements. */
	li + li::before {
		content: '';
		width: 1px;
		height: 16px;
		margin-inline: 16px;
		background: rgba(82, 19, 36, 0.2);
	}

	/* Never squash the avatars or icon badges, even in a tight row. */
	.avatars {
		display: flex;
		flex: none;
		margin-right: 8px;
	}

	/* Bare icon, no circle: wine, sized to the 17 px serif. */
	/*
	 * Badge treatment (entry 55): a soft rose fill with a cream ring like the avatars, and the thin
	 * outline from entry 52 kept just outside it. Same 32 px, so the pill's width is unchanged.
	 */
	.icon {
		flex: none;
		display: inline-grid;
		place-items: center;
		width: 32px;
		height: 32px;
		margin-right: 8px;
		/* Entry 229: the cream ring is back, without the fine outline around it. */
		border: 2px solid var(--cream);
		border-radius: 50%;
		background: var(--rose);
		color: var(--wine);
	}

	/* Entry 230: the guarantee badge, burgundy with a rose seal, so it reads as a stamp, not a bullet. */
	.icon.badge {
		background: var(--wine);
		color: var(--rose);
	}

	.icon :global(svg) {
		width: 18px;
		height: 18px;
	}

	/* Same 32 px as the icon circles (entry 54). */
	.avatars img {
		width: 32px;
		height: 32px;
		border-radius: 50%;
		object-fit: cover;
		border: 2px solid var(--cream);
		margin-left: -10px;
		background: var(--stone);
	}

	.avatars img:first-child {
		margin-left: 0;
	}

	/* Tablets: tighter dividers keep the larger pill on one row in the narrower text column. */
	@media (min-width: 768px) and (max-width: 1023px) {
		li + li::before {
			margin-inline: 12px;
		}
	}
</style>
