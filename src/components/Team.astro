---
import { IMG } from '../data/site';
import CtaButton from './CtaButton.astro';

const team = [
	{ name: 'Mina Munktell', title: 'Specialistsjuksköterska inom viktnedgång och hälsa', img: IMG.mina },
	{ name: 'Daniel da Fonte', title: 'Legitimerad läkare och expert på hållbar viktnedgång', img: IMG.daniel },
	{ name: 'Sandra Merei', title: 'Legitimerad läkare och expert på medicinsk viktbehandling', img: IMG.sandra },
];
---

<section class="section" id="vardteam" aria-labelledby="team-title">
	<div class="container">
		<div class="head" data-reveal>
			<div>
				<p class="label">Ditt vårdteam</p>
				<h2 id="team-title"><span class="line">Samma team följer dig</span> <em>hela vägen.</em></h2>
			</div>
			<blockquote>
				<!-- Two lines, broken after the comma (entry 76). -->
				<p><span>Medicinska beslut fattas av svensklegitimerade läkare,</span> <span>aldrig av en algoritm.</span></p>
			</blockquote>
		</div>
		<ul class="team" role="list">
			{
				team.map((p, i) => (
					<li data-reveal style={`transition-delay: ${i * 120}ms`}>
						<img src={p.img} alt={p.name} width="1024" height="733" loading="lazy" />
						<div>
							<h3>{p.name}</h3>
							<p>{p.title}</p>
						</div>
					</li>
				))
			}
		</ul>
		<!-- Entry 131: one centred booking button under the portraits (replaces entry 129's card and the footnote). -->
		<!-- Entry 216: a secondary "Läs mer om vårt team" to its left. A placeholder: no team page to link to yet. -->
		<div class="team-cta" data-reveal>
			<a class="secondary" role="link" aria-disabled="true">Läs mer om vårt team</a>
			<CtaButton />
		</div>
	</div>
</section>

<style>
	.head {
		display: grid;
		gap: 40px;
	}

	/* "Samma team följer dig" stays on one row (entry 60); "hela vägen." follows below. */
	.head h2 .line {
		display: block;
		white-space: nowrap;
	}

	.head h2 {
		max-width: none;
	}

	blockquote {
		margin: 0;
		padding-left: 20px;
		border-left: 2px solid var(--wine);
		align-self: end;
		container-type: inline-size;
	}

	blockquote p {
		font-family: var(--serif);
		font-style: italic;
		font-size: 1.5rem;
		line-height: 1.3;
		max-width: 22ch;
		/* Trim the space above the capitals and below the baseline so the divider is as tall as the text. */
		text-box: trim-both cap alphabetic;
	}

	/*
	 * From 640 px the quote sits on exactly two lines, split after the comma. The first line is ~20.5em
	 * wide, so 100cqi / 20.8 shrinks the type only where the column is too narrow for 24 px (around
	 * 1024 px); phones keep the natural wrap.
	 */
	@media (min-width: 640px) {
		blockquote p {
			max-width: none;
			font-size: min(1.5rem, 100cqi / 20.8);
		}

		blockquote p span {
			display: block;
			white-space: nowrap;
		}
	}

	.team {
		list-style: none;
		padding: 0;
		margin: 56px 0 32px;
		display: grid;
		gap: 0;
	}

	/* Mobile: compact rows, so three portraits don't take three screens. */
	.team li {
		display: grid;
		grid-template-columns: 96px 1fr;
		gap: 20px;
		align-items: center;
		padding: 20px 0;
		border-top: 1px solid var(--line);
	}

	.team li:last-child {
		border-bottom: 1px solid var(--line);
	}

	.team img {
		width: 100%;
		aspect-ratio: 1;
		object-fit: cover;
		border-radius: 50%;
		background: var(--stone);
	}

	/*
	 * Entry 216: the two buttons side by side and centred. wrap-reverse means that when they don't fit
	 * on one line (phones), the booking button goes on top and the secondary one under it.
	 */
	.team-cta {
		display: flex;
		flex-wrap: wrap-reverse;
		justify-content: center;
		align-items: center;
		gap: 12px;
		margin-top: 16px;
	}

	/* Outline version of CtaButton, same height and type, no arrow. */
	.secondary {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 52px;
		padding: 0 26px;
		border: 1px solid var(--wine);
		border-radius: 999px;
		color: var(--wine);
		font-weight: 600;
		font-size: 0.9375rem;
		letter-spacing: 0.005em;
		white-space: nowrap;
		cursor: pointer;
		transition: background-color 240ms var(--ease);
	}

	.secondary:hover {
		background: rgba(82, 19, 36, 0.06);
	}

	@media (max-width: 479px) {
		.secondary {
			min-height: 52px;
			padding: 0 24px;
			font-size: 0.9375rem;
		}
	}

	.team-cta :global(.cta) {
		justify-items: center;
	}

	h3 {
		font-size: 1.5rem;
	}

	.team p {
		margin-top: 6px;
		color: var(--ink-soft);
		font-size: 0.9375rem;
	}

	@media (min-width: 768px) {
		.team {
			grid-template-columns: repeat(3, 1fr);
			gap: 32px;
		}

		.team li {
			display: block;
			padding: 0;
			border: 0;
		}

		.team li:last-child {
			border: 0;
		}

		.team img {
			aspect-ratio: 4 / 5;
			border-radius: var(--radius);
			margin-bottom: 20px;
		}
	}

	@media (min-width: 1024px) {
		.head {
			grid-template-columns: 1fr 1fr;
			gap: 96px;
		}
	}
</style>
