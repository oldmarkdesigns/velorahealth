---
import { VELORA } from '../data/site';

// Every point is quoted or condensed from velora.se/integritetspolicy and /om-oss.
const points = [
	{ title: 'Aldrig för marknadsföring', text: 'Uppgifter om din hälsa används aldrig för marknadsföring.' },
	{ title: 'Lagras inom EU', text: 'Din journal och dina hälsouppgifter lagras inom EU/EES.' },
	{ title: 'Tystnadsplikt', text: 'All vårdpersonal har tystnadsplikt, och åtkomst till journalen loggas.' },
	{ title: 'Oberoende recept', text: 'Velora säljer inte läkemedel och får ingen ersättning från läkemedelstillverkare.' },
];
---

<section class="section dark" aria-labelledby="privacy-title">
	<div class="container">
		<div data-reveal>
			<p class="label">Trygg vård</p>
			<h2 id="privacy-title">Dina uppgifter är dina. <em>Så skyddar vi dem.</em></h2>
		</div>
		<ol class="points" role="list">
			{
				points.map((p, i) => (
					<li data-reveal style={`transition-delay: ${i * 100}ms`}>
						<span class="num">{String(i + 1).padStart(2, '0')}</span>
						<h3>{p.title}</h3>
						<p>{p.text}</p>
					</li>
				))
			}
		</ol>
		<div class="foot">
			<p>IVO-registrerad vårdgivare · LegitScript-certifierad · Legitimerad vårdpersonal</p>
			<a href={`${VELORA}/integritetspolicy`}>Läs integritetspolicyn</a>
		</div>
	</div>
</section>

<style>
	h2 {
		max-width: none;
	}

	/* "Så skyddar vi dem." always gets its own row (entry 63). */
	h2 em {
		display: block;
		white-space: nowrap;
		color: var(--rose);
	}

	.points {
		list-style: none;
		padding: 0;
		margin: 72px 0 0;
		display: grid;
	}

	.points li {
		padding: 28px 0 32px;
		border-top: 1px solid var(--line);
	}

	.num {
		display: block;
		font-family: var(--serif);
		font-style: italic;
		color: var(--rose);
		margin-bottom: 16px;
	}

	h3 {
		margin-bottom: 10px;
	}

	.points p {
		color: var(--on-dark-soft);
		font-size: 0.9375rem;
		max-width: 32ch;
	}

	.foot {
		margin-top: 56px;
		padding-top: 24px;
		border-top: 1px solid var(--line);
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 12px 24px;
		font-size: 0.875rem;
		color: var(--on-dark-soft);
	}

	.foot a {
		color: var(--on-dark);
		font-weight: 600;
	}

	@media (min-width: 768px) {
		.points {
			grid-template-columns: repeat(2, 1fr);
			column-gap: 48px;
		}
	}

	@media (min-width: 1100px) {
		.points {
			grid-template-columns: repeat(4, 1fr);
			column-gap: 32px;
		}
	}
</style>
