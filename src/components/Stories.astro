---
import arrowIcon from '@phosphor-icons/core/assets/light/arrow-right-light.svg?raw';
import { IMG, VELORA } from '../data/site';

// The hover arrow on "Läs …s berättelse" is the Phosphor icon used as a mask (entry 84).
const arrowMask = `url("data:image/svg+xml,${encodeURIComponent(arrowIcon)}")`;

// Real patient stories from velora.se, summarised faithfully. Individual results, not promises.
const stories = [
	{
		name: 'Caroline',
		age: 47,
		city: 'Jönköping',
		kg: '−15 kg',
		time: 'på 10 månader',
		text: 'Hade testat flera bantningskurer utan resultat. Med medicinsk viktminskning hos Velora gick hon ner 15 kg, och för första gången höll det i sig.',
		img: IMG.caroline,
		href: `${VELORA}/patientberattelser/carolines-viktresa`,
	},
	{
		name: 'Manga',
		age: 35,
		city: 'Tierp',
		kg: '−23 kg',
		time: 'på 10 månader',
		text: 'Var trött på dieter som inte fungerade. Hittade stöd, gick ner 23 kg och fick tillbaka energin och självförtroendet.',
		img: IMG.manga,
		href: `${VELORA}/patientberattelser/mangas-viktresa`,
	},
	{
		name: 'Roger',
		age: 59,
		city: 'Norrköping',
		kg: '−25 kg',
		time: 'på 6 månader',
		text: 'När sjukdom satte stopp för träningen ökade vikten. Med rätt stöd hittade han tillbaka till styrka, energi och hälsa.',
		img: IMG.roger,
		href: `${VELORA}/patientberattelser/rogers-viktresa`,
	},
];
---

<section class="section stone" id="patientberattelser" aria-labelledby="stories-title">
	<div class="container head" data-reveal>
		<div>
			<p class="label">Patientberättelser</p>
			<h2 id="stories-title">Tre personer.<br />Tre <em>egna</em> vägar.</h2>
		</div>
		<a class="all" href={`${VELORA}/patientberattelser`}>Fler berättelser</a>
	</div>
	<ul class="rail container" role="list">
		{
			stories.map((s, i) => (
				<li class="story" data-reveal style={`transition-delay: ${i * 120}ms`}>
					<div class="photo">
						<img src={s.img} alt={`${s.name}, ${s.age} år`} width="600" height="800" loading="lazy" />
						<div class="shade" aria-hidden="true" />
					</div>
					<!-- Entry 133: the text sits inside the photo, at the bottom; the link covers the whole card. -->
					<div class="body">
						<div class="copy">
							<p class="result">
								<span class="kg">{s.kg}</span>
								<span class="time">{s.time}</span>
							</p>
							<p class="who">
								{s.name}, {s.age} år, {s.city}
							</p>
							<p class="text">{s.text}</p>
							<a class="read" href={s.href} style={`--arrow: ${arrowMask}`}>
								Läs {s.name}s berättelse<span class="arrow" aria-hidden="true">&nbsp;&emsp;</span><span class="visually-hidden"> på velora.se</span>
							</a>
						</div>
					</div>
				</li>
			))
		}
	</ul>
	<div class="container">
		<p class="footnote">Berättelserna är enskilda personers erfarenheter. Resultat varierar från person till person.</p>
	</div>
</section>

<style>
	.head {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 24px;
	}

	.all {
		display: none;
		font-weight: 600;
		font-size: 0.9375rem;
	}

	/* Entry 161: no swipe row any more. Below 1024 px the stories stack, one full-width card each. */
	.rail {
		list-style: none;
		margin: 56px auto 40px;
		display: grid;
		gap: 20px;
	}

	/* Entry 133: one photo card, the text laid over its foot; the whole card is the link. */
	.story {
		position: relative;
		overflow: hidden;
		border-radius: var(--radius);
		color: var(--cream);
	}

	.photo {
		position: relative;
		height: 100%;
	}

	.photo img {
		width: 100%;
		height: 100%;
		min-height: 100%;
		aspect-ratio: 3 / 4;
		object-fit: cover;
		object-position: center 20%;
		transition: transform 1200ms var(--ease);
	}

	/* Holds the hover wash; the reading gradient sits behind the text itself (.copy). */
	.shade {
		position: absolute;
		inset: 0;
	}

	/* Hover: the photo darkens a little more (an extra even wash over the gradient). */
	.shade::after {
		content: '';
		position: absolute;
		inset: 0;
		background: rgba(0, 0, 0, 0.18);
		opacity: 0;
		transition: opacity 400ms var(--ease);
	}

	.story:hover .photo img {
		transform: scale(1.03);
	}

	.story:hover .shade::after,
	.story:focus-within .shade::after {
		opacity: 1;
	}

	/* Fills the card (so the stretched link below covers all of it); the text sits at the foot. */
	.body {
		position: absolute;
		inset: 0;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
	}

	/*
	 * The dark gradient belongs to the text block: clear 96 px above it, deepening to the bottom edge,
	 * so the text is always on the dark part whatever the card's size.
	 */
	.copy {
		padding: 96px 24px 24px;
		background: linear-gradient(
			to bottom,
			rgba(0, 0, 0, 0) 0,
			rgba(0, 0, 0, 0.45) 72px,
			rgba(0, 0, 0, 0.66) 50%,
			rgba(0, 0, 0, 0.8) 100%
		);
	}

	.result {
		display: flex;
		align-items: baseline;
		gap: 10px;
	}

	.kg {
		font-family: var(--serif);
		font-weight: 300;
		font-size: 3rem;
		line-height: 1;
		letter-spacing: -0.03em;
	}

	.time {
		font-size: 0.875rem;
		color: var(--on-dark-soft);
	}

	.who {
		margin-top: 14px;
		padding-top: 14px;
		border-top: 1px solid var(--line-dark);
		font-size: 0.8125rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.text {
		margin-top: 8px;
		color: rgba(247, 242, 236, 0.82);
		font-size: 0.9375rem;
		line-height: 1.5;
	}

	.read {
		display: inline-block;
		margin-top: 14px;
		color: var(--cream);
		font-weight: 600;
		font-size: 0.9375rem;
	}

	/* The link stretches over the whole card, so a click anywhere opens the story. */
	.read::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: 1;
		border-radius: var(--radius);
	}

	.read:focus-visible {
		outline: none;
	}

	.read:focus-visible::before {
		outline: 2px solid var(--wine);
		outline-offset: -2px;
		box-shadow: inset 0 0 0 4px var(--cream);
	}

	/*
	 * Hover (entries 84, 96): the underline glides out to the right while an arrow slides in after
	 * the label; both retract on leave. The arrow's slot is a no-break space plus an em space in an
	 * inline span, so the link's own underline (drawn with the link's metrics) runs beneath it. The
	 * slot's font-size animates from 0, which widens it smoothly. The icon is a masked pseudo-element
	 * in fixed px, so it doesn't scale with the slot. At rest the slot is 0 wide: unchanged look.
	 */
	.arrow {
		position: relative;
		font-size: 0;
		transition: font-size 380ms var(--ease);
	}

	.arrow::after {
		content: '';
		position: absolute;
		right: 0;
		bottom: 0.18rem;
		width: 15px;
		height: 15px;
		background: currentColor;
		mask: var(--arrow) center / contain no-repeat;
		-webkit-mask: var(--arrow) center / contain no-repeat;
		opacity: 0;
		translate: -10px 0;
		transition:
			translate 380ms var(--ease),
			opacity 200ms var(--ease);
	}

	@media (hover: hover) {
		.story:hover .read .arrow {
			font-size: 1em;
		}

		.story:hover .read .arrow::after {
			opacity: 1;
			translate: 0 0;
			transition-delay: 60ms;
		}
	}

	.read:focus-visible .arrow {
		font-size: 1em;
	}

	.read:focus-visible .arrow::after {
		opacity: 1;
		translate: 0 0;
	}

	@media (prefers-reduced-motion: reduce) {
		.arrow,
		.arrow::after {
			transition: none;
		}
	}

	/*
	 * Phones (entry 133): the card is narrow, so it is taller (2:3) and the type a step smaller, so the
	 * text leaves the faces clear.
	 */
	@media (max-width: 767px) {
		.photo img {
			aspect-ratio: 2 / 3;
		}

		.copy {
			padding: 88px 20px 20px;
		}

		.result {
			white-space: nowrap;
		}

		.kg {
			font-size: 2.5rem;
		}

		.text {
			font-size: 0.875rem;
		}
	}

	@media (min-width: 768px) {
		.all {
			display: inline;
		}

		/* Tablets: stacked like phones (entry 161); three across are too narrow for the text on the photo. */
		.rail {
			gap: 24px;
		}

		/* Tablets: a full-width card at 3:4 would be ~940 px tall, so a wider 4:3 frame. */
		.photo img {
			aspect-ratio: 4 / 3;
		}
	}

	@media (min-width: 1024px) {
		.rail {
			grid-template-columns: repeat(3, 1fr);
			gap: 32px;
		}

		.photo img {
			aspect-ratio: 3 / 4;
		}
	}
</style>
