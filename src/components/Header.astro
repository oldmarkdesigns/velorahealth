---
import { IMG } from '../data/site';
import CtaButton from './CtaButton.astro';

// Mirrors velora.se's own Viktmediciner menu (prompt log entry 29). Descriptions are the substance
// and form only, as stated on velora.se/viktmediciner; no effect claims.
// Every link jumps within this page (entry 80): the page has no section per medicine, so the
// medicines open the FAQ answer "Vilka läkemedel förskriver ni?".
const MEDICINES_FAQ = '#faq-lakemedel';
const medicines = [
	{ name: 'Mounjaro', meta: 'Tirzepatid, injektionspenna', href: MEDICINES_FAQ },
	{ name: 'Ozempic', meta: 'Semaglutid, injektionspenna', href: MEDICINES_FAQ },
	{ name: 'Rybelsus', meta: 'Semaglutid, tablett', href: MEDICINES_FAQ },
	{ name: 'Wegovy', meta: 'Semaglutid, injektionspenna', href: MEDICINES_FAQ },
];

const cards = [
	{ label: 'Om viktmediciner', href: '#faq-varfor-lakemedel', img: IMG.pen, alt: 'Läkare håller i en injektionspenna' },
	{
		label: 'Så fungerar behandlingen',
		href: '#sa-fungerar-det',
		img: IMG.videoMeeting,
		alt: 'Kvinna som pratar med en läkare via datorn',
	},
];
---

<!-- Sits over the full-bleed hero, so it has no background of its own (until a menu opens). -->
<!-- 1px marker at the top of the page: once it scrolls out of view, the navbar turns into a floating bar. -->
<!-- Also the logo's jump target: the very top of the page. -->
<div class="scroll-sentinel" id="top" data-scroll-sentinel aria-hidden="true"></div>
<header class="header" data-header data-load="down" style="--load-delay: 150ms">
	<div class="container inner">
		<a href="#top" class="logo" aria-label="Velora, till toppen av sidan">
			<span class="mark" style={`--logo: url(${IMG.logoPlum})`}></span>
		</a>
		<nav aria-label="Huvudmeny" class="nav">
			<a class="nav-link" href="#sa-fungerar-det">Behandlingen</a>

			<!-- Oura-inspired menu, adapted to Velora: the bar and panel become one cream surface. -->
			<div class="menu" data-menu>
				<button
					type="button"
					class="nav-link trigger"
					aria-expanded="false"
					aria-controls="menu-viktmediciner"
					data-menu-button
				>
					Viktmediciner
					<svg aria-hidden="true" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"></path></svg>
				</button>
				<div class="panel" id="menu-viktmediciner" data-menu-panel>
					<div class="container panel-inner">
						<ul class="cards" role="list">
							{
								cards.map((c) => (
									<li>
										<a class="card" href={c.href}>
											<img src={c.img} alt={c.alt} width="600" height="400" loading="lazy" />
											<span class="card-label">{c.label}</span>
											<span class="card-arrow" aria-hidden="true">
												<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
											</span>
										</a>
									</li>
								))
							}
						</ul>
						<ul class="list" role="list">
							{
								medicines.map((m) => (
									<li>
										<a class="row" href={m.href}>
											<span class="row-name">{m.name}</span>
											<span class="row-meta">{m.meta}</span>
										</a>
									</li>
								))
							}
							<li>
								<a class="row all" href={MEDICINES_FAQ}>
									<span class="all-dot" aria-hidden="true">
										<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
									</span>
									<span class="row-name">Allt om viktmediciner</span>
								</a>
							</li>
						</ul>
					</div>
				</div>
			</div>

			<a class="nav-link" href="#patientberattelser">Patientberättelser</a>
			<a class="nav-link" href="#vardteam">Om Velora</a>
			<a class="nav-link" href="#pris">Pris</a>
			<a class="nav-link" href="#vanliga-fragor">Vanliga frågor</a>
		</nav>
		<div class="actions">
			<a class="login" href="https://velora.kaddio.com/login">Logga in</a>
			<div class="header-cta"><CtaButton size="sm" inline={false} label="Kom igång" /></div>
			<!-- Entry 144: below 1024 px the links and "Logga in" live behind a two-stroke burger. -->
			<button
				type="button"
				class="burger"
				aria-expanded="false"
				aria-controls="mobile-menu"
				aria-label="Meny"
				data-burger
			>
				<span aria-hidden="true"></span>
				<span aria-hidden="true"></span>
			</button>
		</div>
	</div>
	<div class="mobile-menu" id="mobile-menu" data-mobile-menu data-lenis-prevent>
		<nav aria-label="Huvudmeny" class="container mobile-nav">
			<a href="#sa-fungerar-det">Behandlingen</a>
			<!-- Entry 147: Viktmediciner opens the same content as the desktop menu, as an accordion. -->
			<details class="mobile-group">
				<summary>
					Viktmediciner
					<svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"></path></svg>
				</summary>
				<div class="mobile-sub">
					<ul class="mobile-cards" role="list">
						{
							cards.map((c) => (
								<li>
									<a class="card" href={c.href}>
										<img src={c.img} alt={c.alt} width="600" height="400" loading="lazy" />
										<span class="card-label">{c.label}</span>
									</a>
								</li>
							))
						}
					</ul>
					<ul class="list" role="list">
						{
							medicines.map((m) => (
								<li>
									<a class="row" href={m.href}>
										<span class="row-name">{m.name}</span>
										<span class="row-meta">{m.meta}</span>
									</a>
								</li>
							))
						}
						<li>
							<a class="row all" href={MEDICINES_FAQ}>
								<span class="all-dot" aria-hidden="true">
									<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
								</span>
								<span class="row-name">Allt om viktmediciner</span>
							</a>
						</li>
					</ul>
				</div>
			</details>
			<a href="#patientberattelser">Patientberättelser</a>
			<a href="#vardteam">Om Velora</a>
			<a href="#pris">Pris</a>
			<a href="#vanliga-fragor">Vanliga frågor</a>
			<a class="mobile-login" href="https://velora.kaddio.com/login">Logga in</a>
		</nav>
	</div>
</header>
<div class="menu-scrim" data-menu-scrim aria-hidden="true"></div>

<script>
	const header = document.querySelector<HTMLElement>('[data-header]');
	const menu = header?.querySelector<HTMLElement>('[data-menu]');
	const button = menu?.querySelector<HTMLButtonElement>('[data-menu-button]');
	const scrim = document.querySelector<HTMLElement>('[data-menu-scrim]');

	// Oura-style scroll state, observed rather than computed on every scroll event.
	const sentinel = document.querySelector<HTMLElement>('[data-scroll-sentinel]');
	if (header && sentinel) {
		new IntersectionObserver(([entry]) => {
			header.classList.toggle('is-scrolled', !entry.isIntersecting);
		}).observe(sentinel);
	}

	// Hide while scrolling down, reveal on any scroll up (Oura pattern). Direction needs the scroll
	// position, so this is a passive listener throttled to one check per frame.
	if (header) {
		const SHOW_NEAR_TOP = 120;
		const MIN_DELTA = 6;
		let lastY = window.scrollY;
		let frame = 0;

		const check = () => {
			frame = 0;
			const y = window.scrollY;
			const delta = y - lastY;
			if (y <= SHOW_NEAR_TOP) {
				header.classList.remove('is-hidden');
				lastY = y;
				return;
			}
			if (Math.abs(delta) < MIN_DELTA) return;
			// Never hide an open menu.
			header.classList.toggle('is-hidden', delta > 0 && !header.classList.contains('is-open'));
			lastY = y;
		};

		window.addEventListener('scroll', () => {
			if (!frame) frame = requestAnimationFrame(check);
		}, { passive: true });
	}

	// Entry 144: the mobile burger menu. Opening it turns the bar into one cream surface with the
	// panel (the same is-open state as the desktop menu) and dims the page behind it.
	const burger = header?.querySelector<HTMLButtonElement>('[data-burger]');
	const mobileMenu = header?.querySelector<HTMLElement>('[data-mobile-menu]');
	if (header && burger && mobileMenu && scrim) {
		const setMobileOpen = (open: boolean) => {
			burger.setAttribute('aria-expanded', String(open));
			burger.setAttribute('aria-label', open ? 'Stäng meny' : 'Meny');
			header.classList.toggle('is-open', open);
			header.classList.toggle('is-mobile-open', open);
			scrim.classList.toggle('is-open', open);
			if (open) header.classList.remove('is-hidden');
		};
		const mobileOpen = () => burger.getAttribute('aria-expanded') === 'true';

		burger.addEventListener('click', () => setMobileOpen(!mobileOpen()));
		// Every link jumps within the page (or leaves for the login), so close the menu behind it.
		mobileMenu.addEventListener('click', (e) => {
			if ((e.target as Element).closest('a')) setMobileOpen(false);
		});
		scrim.addEventListener('click', () => setMobileOpen(false));
		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && mobileOpen()) {
				setMobileOpen(false);
				burger.focus();
			}
		});
		// Entry 152: Viktmediciner opens and closes smoothly. CSS can't animate <details> to its natural
		// height in every browser (Safari), so the content's height is animated with the Web Animations
		// API: open first, then grow from 0; on close, shrink to 0, then close.
		const group = mobileMenu.querySelector<HTMLDetailsElement>('.mobile-group');
		const groupBody = group?.querySelector<HTMLElement>('.mobile-sub');
		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
		group?.querySelector('summary')?.addEventListener('click', (e) => {
			if (!groupBody || reduceMotion.matches) return;
			e.preventDefault();
			const opening = !group.open;
			const from = opening ? 0 : groupBody.offsetHeight;
			if (opening) group.open = true;
			const to = opening ? groupBody.offsetHeight : 0;
			groupBody.getAnimations().forEach((a) => a.cancel());
			// The bottom padding animates with the height, so the closed state is truly 0 tall.
			const shut = { height: '0px', paddingBottom: '0px', opacity: 0 };
			const full = { height: `${opening ? to : from}px`, opacity: 1 };
			const anim = groupBody.animate(opening ? [shut, full] : [full, shut],
				{ duration: 380, easing: 'cubic-bezier(0.2, 0.7, 0.2, 1)' },
			);
			anim.onfinish = () => {
				if (!opening) group.open = false;
			};
		});

		// Rotating to a desktop width closes it, since the burger disappears there.
		window.matchMedia('(min-width: 1024px)').addEventListener('change', (e) => {
			if (e.matches && mobileOpen()) setMobileOpen(false);
		});
	}

	if (header && menu && button && scrim) {
		let timer = 0;
		const isOpen = () => button.getAttribute('aria-expanded') === 'true';

		const setOpen = (open: boolean) => {
			window.clearTimeout(timer);
			button.setAttribute('aria-expanded', String(open));
			header.classList.toggle('is-open', open);
			scrim.classList.toggle('is-open', open);
			if (open) header.classList.remove('is-hidden');
		};

		button.addEventListener('click', () => setOpen(!isOpen()));

		// A link in the panel jumps within the page, so close the menu behind it.
		menu.querySelector('[data-menu-panel]')?.addEventListener('click', (e) => {
			if ((e.target as Element).closest('a')) setOpen(false);
		});

		// Hover intent on mouse devices only: a short delay in, a longer grace period out.
		if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
			menu.addEventListener('mouseenter', () => {
				window.clearTimeout(timer);
				timer = window.setTimeout(() => setOpen(true), 90);
			});
			menu.addEventListener('mouseleave', () => {
				window.clearTimeout(timer);
				timer = window.setTimeout(() => setOpen(false), 220);
			});
		}

		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && isOpen()) {
				setOpen(false);
				button.focus();
			}
		});

		// Close when keyboard focus moves past the menu, or on a click outside it.
		menu.addEventListener('focusout', (e) => {
			if (!menu.contains(e.relatedTarget as Node | null)) setOpen(false);
		});
		scrim.addEventListener('click', () => setOpen(false));
	}
</script>

<style>
	/*
	 * Fixed to the top edge. At the top of the page it is transparent over the hero; once scrolled, a
	 * rounded, frosted cream surface fades in behind the same content (Oura's floating bar, in Velora's
	 * palette). The surface is a pseudo-element, so nothing reflows: only its opacity animates.
	 */
	.header {
		position: fixed;
		inset: 0 0 auto;
		z-index: 10;
		transition:
			background-color 300ms var(--ease),
			transform 360ms var(--ease);
	}

	/* Scrolled down: slide fully out of view, shadow included (only transform animates). */
	.header.is-hidden {
		transform: translateY(calc(-100% - 24px));
	}

	/* Keyboard users always see the bar while focus is in it. */
	.header.is-hidden:focus-within {
		transform: none;
	}

	.header::before {
		content: '';
		position: absolute;
		inset: 10px 8px;
		border-radius: 16px;
		background: rgba(247, 242, 236, 0.72);
		backdrop-filter: blur(20px) saturate(140%);
		-webkit-backdrop-filter: blur(20px) saturate(140%);
		border: 1px solid rgba(255, 255, 255, 0.55);
		box-shadow: 0 12px 32px -20px rgba(82, 19, 36, 0.35);
		opacity: 0;
		transition: opacity 300ms var(--ease);
		pointer-events: none;
		/* Behind the bar's content but above its own background (the header is a stacking context). */
		z-index: -1;
	}

	.header.is-scrolled::before {
		opacity: 1;
	}

	/*
	 * Phones and tablets (entry 148): like velora.se's mobile bar, it stays put while scrolling (no
	 * slide-away) and, once scrolled, spans the full width flush with the top edge: a see-through,
	 * frosted cream band with a hairline beneath, instead of the floating rounded bar.
	 */
	@media (max-width: 1023px) {
		.header.is-hidden {
			transform: none;
		}

		.header::before {
			inset: 0;
			border: 0;
			border-bottom: 1px solid var(--line);
			border-radius: 0;
			box-shadow: none;
			background: rgba(247, 242, 236, 0.78);
		}

		/* Entry 159: the band shows from the start, at the top of the page too (not only once scrolled). */
		.header:not(.is-open)::before {
			opacity: 1;
		}
	}

	/* Desktop: the floating bar hugs the content (20 px around logo and CTA) instead of spanning the page. */
	@media (min-width: 1024px) {
		.header::before {
			/* Content starts at (100% - max) / 2; the bar starts 20 px before it. */
			inset-inline: max(12px, calc((100% - var(--max)) / 2 - 20px));
		}
	}

	/* An open menu turns the whole bar into one cream surface with the panel, as before. */
	.header.is-open::before {
		opacity: 0;
	}

	.scroll-sentinel {
		position: absolute;
		top: 0;
		left: 0;
		width: 1px;
		height: 24px;
		pointer-events: none;
	}

	.header.is-open {
		background: var(--cream);
	}

	.inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
		min-height: 80px;
	}

	/* The logo file is plum; a mask recolours it to deep wine to match the new primary. */
	.mark {
		display: block;
		height: 26px;
		aspect-ratio: 817 / 213;
		background: var(--wine);
		mask: var(--logo) center / contain no-repeat;
		-webkit-mask: var(--logo) center / contain no-repeat;
		transition: background-color 300ms var(--ease);
	}

	.nav {
		display: none;
		align-items: center;
		gap: 32px;
		margin-right: auto;
		margin-left: 40px;
	}

	.nav-link,
	.login {
		color: var(--ink);
		text-decoration: none;
		font-size: 0.9375rem;
		font-weight: 500;
	}

	.nav-link:hover {
		text-decoration: underline;
	}

	/*
	 * Entry 186: over the hero photo (desktop, top of the page) the menu links are white. On the
	 * floating cream bar, or with the Viktmediciner menu open, they go back to ink so they stay legible.
	 */
	@media (min-width: 1024px) {
		.header:not(.is-scrolled):not(.is-open) .nav-link {
			color: #fff;
			text-shadow: 0 1px 10px rgba(0, 0, 0, 0.3);
		}

		/* Entry 187: the logo goes white with them, over the hero's dark top band. */
		.header:not(.is-scrolled):not(.is-open) .mark {
			background: #fff;
		}
	}

	/*
	 * Entries 108–109: "Logga in" is a pill beside the wine CTA, same height as the small button.
	 * Entry 123: solid white with wine text; entry 188: back to a white outline with white text.
	 */
	.login {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		padding: 0 20px;
		border-radius: 999px;
		border: 1px solid #fff;
		background: transparent;
		color: #fff;
		font-size: 0.875rem;
		font-weight: 600;
		transition:
			background-color 240ms var(--ease),
			color 240ms var(--ease),
			border-color 240ms var(--ease);
	}

	/* Entry 188: an outline pill again, white stroke and text over the hero's dark top band. */
	.login:hover {
		background: rgba(255, 255, 255, 0.16);
	}

	/* On the floating cream bar (or with a menu open) white would vanish, so it turns burgundy. */
	.header.is-scrolled .login,
	.header.is-open .login {
		color: var(--ink);
		border-color: rgba(82, 19, 36, 0.35);
	}

	.header.is-scrolled .login:hover,
	.header.is-open .login:hover {
		background: rgba(82, 19, 36, 0.06);
	}

	.trigger {
		all: unset;
		box-sizing: border-box;
		display: inline-flex;
		align-items: center;
		gap: 6px;
		color: var(--ink);
		font-family: var(--sans);
		font-size: 0.9375rem;
		font-weight: 500;
		cursor: pointer;
	}

	.trigger:focus-visible {
		outline: 2px solid var(--wine);
		outline-offset: 4px;
		border-radius: 2px;
	}

	.trigger svg {
		transition: transform 300ms var(--ease);
	}

	.is-open .trigger {
		text-decoration: underline;
		text-underline-offset: 0.25em;
	}

	.is-open .trigger svg {
		transform: rotate(180deg);
	}

	/* ---- Panel: drops from the bar as one continuous cream surface ---- */
	.panel {
		position: absolute;
		top: 100%;
		left: 0;
		right: 0;
		background: var(--cream);
		border-bottom-left-radius: var(--radius);
		border-bottom-right-radius: var(--radius);
		box-shadow: 0 24px 48px -24px rgba(82, 19, 36, 0.28);
		visibility: hidden;
		opacity: 0;
		transform: translateY(-8px);
		transition:
			opacity 300ms var(--ease),
			transform 300ms var(--ease),
			visibility 0s linear 300ms;
	}

	.is-open .panel {
		visibility: visible;
		opacity: 1;
		transform: none;
		transition-delay: 0s;
	}

	.panel-inner {
		display: grid;
		grid-template-columns: 1fr 1fr 0.9fr;
		gap: 32px;
		padding-block: 24px 40px;
	}

	.cards {
		display: contents;
		list-style: none;
	}

	.card {
		position: relative;
		display: block;
		overflow: hidden;
		border-radius: var(--radius);
		color: var(--cream);
		text-decoration: none;
	}

	.card img {
		width: 100%;
		aspect-ratio: 16 / 10;
		object-fit: cover;
		transition: transform 900ms var(--ease);
	}

	/* Wine veil so the cream label reads on any photo. */
	.card::after {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(to top, rgba(82, 19, 36, 0.72) 0%, rgba(82, 19, 36, 0) 55%);
	}

	/* Entry 219: no image zoom on touch screens or below desktop width. */
	@media (hover: hover) and (min-width: 1024px) {
		.card:hover img,
		.card:focus-visible img {
			transform: scale(1.04);
		}
	}

	.card-label {
		position: absolute;
		left: 20px;
		bottom: 18px;
		z-index: 1;
		font-family: var(--serif);
		font-size: 1.5rem;
		font-weight: 340;
		line-height: 1.1;
		max-width: 70%;
	}

	.card-arrow {
		position: absolute;
		right: 16px;
		bottom: 16px;
		z-index: 1;
		display: grid;
		place-items: center;
		width: 40px;
		height: 40px;
		border-radius: 50%;
		background: var(--cream);
		color: var(--wine);
		transition: transform 300ms var(--ease);
	}

	.card:hover .card-arrow,
	.card:focus-visible .card-arrow {
		transform: translateX(3px);
	}

	.list {
		list-style: none;
		margin: 0;
		padding: 0;
		align-self: center;
	}

	.row {
		display: flex;
		align-items: baseline;
		gap: 12px;
		padding: 10px 0;
		color: var(--ink);
		text-decoration: none;
	}

	.row-name {
		font-family: var(--serif);
		font-size: 1.375rem;
		font-weight: 340;
		transition: transform 300ms var(--ease);
	}

	.row-meta {
		font-size: 0.8125rem;
		color: var(--ink-soft);
	}

	.row:hover .row-name,
	.row:focus-visible .row-name {
		transform: translateX(4px);
	}

	.row:focus-visible {
		outline: 2px solid var(--wine);
