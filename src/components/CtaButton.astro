---
import { CTA } from '../data/site';

interface Props {
	size?: 'md' | 'sm';
	// On deep-wine backgrounds the button inverts to cream so it stays the strongest element.
	tone?: 'wine' | 'cream';
	// Inline CTAs are tracked by the sticky bar so it never doubles up with one on screen.
	inline?: boolean;
	// Overrides the shared label (the navbar uses the shorter "Kom igång"); link and styling stay shared.
	label?: string;
	// A short reassurance line under the button, answering the doubt of the section it sits in.
	note?: string;
}

const { size = 'md', tone = 'wine', inline = true, label = CTA.label, note } = Astro.props;
---

<div class:list={['cta', size, tone]} data-cta-inline={inline ? '' : undefined}>
	<a class="btn" href={CTA.href}>
		<span>{label}</span>
		<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
	</a>
	{note && <p class="note">{note}</p>}
</div>

<style>
	.cta {
		display: grid;
		gap: 14px;
		justify-items: start;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		/* Entry 221: lighter on desktop too (was 58 px tall, 30 px padding, 16 px text). */
		gap: 12px;
		min-height: 52px;
		padding: 0 26px;
		border-radius: 999px;
		background: var(--wine);
		color: var(--cream);
		font-weight: 600;
		font-size: 0.9375rem;
		letter-spacing: 0.005em;
		text-decoration: none;
		white-space: nowrap;
		transition:
			background-color 240ms var(--ease),
			color 240ms var(--ease);
	}

	.btn:hover {
		background: var(--wine-hover);
	}

	.btn svg {
		transition: transform 240ms var(--ease);
	}

	.btn:hover svg {
		transform: translateX(4px);
	}

	/* 2026-11-05: a little inset from the button's edge where the note sits left-aligned. */
	.note {
		padding-left: 14px;
		font-size: 0.875rem;
		color: var(--ink-soft);
	}

	.cream .note {
		color: var(--on-dark-soft);
	}

	.cream .btn {
		background: var(--cream);
		color: var(--wine);
	}

	.cream .btn:hover {
		background: #fff;
	}

	.sm .btn {
		min-height: 44px;
		padding: 0 20px;
		font-size: 0.875rem;
		gap: 10px;
	}

	/*
	 * Phones (entry 209): a lighter button that hugs its label, with its arrow, instead of stretching
	 * across the screen. Desktop and tablets are unchanged.
	 */
	@media (max-width: 479px) {
		.md .btn {
			min-height: 52px;
			padding: 0 24px;
			gap: 12px;
			font-size: 0.9375rem;
		}
	}

	/* The narrowest phones (320 px): drop the arrow so the longest label still fits on one line. */
	@media (max-width: 359px) {
		.md .btn {
			padding: 0 20px;
		}

		.md .btn svg {
			display: none;
		}
	}
</style>
