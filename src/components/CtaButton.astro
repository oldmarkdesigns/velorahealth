---
import { CTA } from '../data/site';

interface Props {
	size?: 'md' | 'sm';
	// On deep-wine backgrounds the button inverts to cream so it stays the strongest element.
	tone?: 'wine' | 'cream';
	// Inline CTAs are tracked by the sticky bar so it never doubles up with one on screen.
	inline?: boolean;
	// Overrides the shared label (the navbar uses the shorter "Kom igång"); link and styling stay shared.
	label?: string;
}

const { size = 'md', tone = 'wine', inline = true, label = CTA.label } = Astro.props;
---

<div class:list={['cta', size, tone]} data-cta-inline={inline ? '' : undefined}>
	<a class="btn" href={CTA.href}>
		<span>{label}</span>
		<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
	</a>
</div>

<style>
	.cta {
		display: grid;
		gap: 14px;
		justify-items: start;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 14px;
		min-height: 58px;
		padding: 0 30px;
		border-radius: 999px;
		background: var(--wine);
		color: var(--cream);
		font-weight: 600;
		font-size: 1rem;
		letter-spacing: 0.005em;
		text-decoration: none;
		white-space: nowrap;
		transition:
			background-color 240ms var(--ease),
			color 240ms var(--ease);
	}

	.btn:hover {
		background: var(--wine-hover);
	}

	.btn svg {
		transition: transform 240ms var(--ease);
	}

	.btn:hover svg {
		transform: translateX(4px);
	}

	.cream .btn {
		background: var(--cream);
		color: var(--wine);
	}

	.cream .btn:hover {
		background: #fff;
	}

	.sm .btn {
		min-height: 44px;
		padding: 0 20px;
		font-size: 0.875rem;
		gap: 10px;
	}

	/* Narrow screens: full-width button, arrow dropped so the full label fits on one line. */
	@media (max-width: 479px) {
		.md {
			justify-items: stretch;
		}

		/* Inside padded cards on the narrowest phones (320 px) the label can't fit one line: let it wrap, centred. */
		.md .btn {
			padding: 10px 18px;
			white-space: normal;
			text-align: center;
			line-height: 1.3;
		}

		.md .btn svg {
			display: none;
		}
	}
</style>
